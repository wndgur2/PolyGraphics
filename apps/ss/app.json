{
  "id": "ss",
  "name": "Shape Survivors",
  "premise": "The protagonist has lost their pheromone transmitter, and the hive hunts them for the silence.",
  "engines": ["phaser"],
  "categories": ["char", "figure", "enemy", "proj", "fx", "pickup", "terrain", "env", "icon", "relic", "curse", "draught", "app", "lib"],

  "reference": {
    "ground": { "field": "ss.env.ground", "pan": "ss.env.pan" },
    "plate": { "relic": "ss.lib.relic-plate", "curse": "ss.lib.relic-plate" },
    "scale": 1.35,
    "contrast": { "sinks": 2.5, "thin": 3.5, "badge": 3, "badgeLit": 0.04 }
  },

  "rules": {
    "grid": { "applies": ["char", "figure", "icon", "relic", "draught", "curse", "env", "app", "fx", "lib"] },
    "size": { "char": [32, 32], "icon": [32, 32], "relic": [32, 32], "draught": [32, 32] },
    "meta": [{ "in": ["enemy", "char", "figure"], "unless": ["projectile"], "require": ["radius"] }],
    "clips": [{ "in": ["enemy"], "unless": ["projectile"], "require": ["death"] }],
    "oneShot": { "death": { "settleBy": 0.85 } },
    "states": {
      "enemy": ["elite", "enraged", "final", "buried", "elite_buried", "spent", "grub", "loosed", "planted"],
      "proj": ["evolved", "worn", "muck", "evolved-worn", "evolved-muck"],
      "icon": ["evolved"],
      "relic": ["glyph"],
      "curse": ["glyph"],
      "pickup": ["cursed"],
      "terrain": ["filled"],
      "app": ["maskable"],
      "lib": "*"
    },
    "roles": {
      "hive": ["pheromone", "pink"],
      "arsenal": ["husk", "bone", "chitin", "timber", "frost"],
      "evolved": ["gold"]
    },
    "paint": [
      { "in": ["proj"], "forbid": "hive", "except": ["ss.proj.mine"], "because": "the arsenal is hive material with the signal stripped out" },
      { "in": ["icon"], "tagged": ["weapon"], "forbid": "hive", "except": ["ss.icon.mine"], "because": "the arsenal is hive material with the signal stripped out" }
    ],
    "says": [
      {
        "in": ["relic", "curse"],
        "beats": {
          "more": "the thing drawn again, and the one that was added set apart from the ones that were already there",
          "faster": "a clock the drawing is ahead of — a fuse burnt down, a beat run tight, a body already past where it was",
          "longer": "the effect still there after what made it has gone",
          "wider": "a ring, a cloud or a reach that goes past the body that made it",
          "harder": "coral on the beat that lands, or the wound it opens drawn open",
          "tougher": "a plate over the body, or the hit drawn glancing off",
          "heals": "something budding, regrown or mending, on a body that was open",
          "hides": "the body broken off its own outline, or standing where it is not looked for",
          "slows": "what is coming drawn caught — held, stuck, or a beat behind",
          "finds": "the ruin's gold on what is handed over, and more of it than one",
          "costs": "what is taken drawn beside what is given, on the same plate"
        }
      }
    ],
    "distinct": [{ "in": ["icon"], "tagged": ["weapon"], "part": "tile", "minDeltaE": 13 }],
    "contracts": {
      "ss.proj.ring": { "meta.radius": 62 },
      "ss.proj.dung": { "meta.radius": 14 },
      "ss.proj.aura": { "meta.radius": 64 },
      "ss.fx.dung-burst": { "meta.radius": 30 }
    },
    "layers": [
      { "in": ["env"], "layer": "bg" },
      { "in": ["terrain"], "layer": "ground" },
      { "in": ["pickup"], "layer": "pickup" },
      { "in": ["enemy"], "tagged": ["boss"], "layer": "boss" },
      { "in": ["enemy"], "layer": "enemy" },
      { "in": ["proj", "fx"], "layer": "fx" },
      { "in": ["char", "figure"], "layer": "player" },
      { "in": ["icon", "relic", "curse", "draught", "app"], "layer": "ui" }
    ],
    "levels": { "contracts": "error", "namespace": "error" }
  },

  "audio": {
    "key": ["tonic", "third", "fifth", "seventh"],
    "inKey": ["fanfare"],
    "families": ["weapon", "impact", "creature", "player", "pickup", "world", "field", "interface", "fanfare"]
  }
}
