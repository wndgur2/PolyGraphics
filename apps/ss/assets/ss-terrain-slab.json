    { "id": "top", "at": [0, -6], "shape": { "kind": "rect", "w": 42, "h": 6, "corner": 2 }, "fill": "$smoke.light2" },
    { "id": "seam_l", "at": [-6, -1], "shape": { "kind": "rect", "w": 2, "h": 16 }, "fill": "$ink" },
