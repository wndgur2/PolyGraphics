  "variants": {
    "ripe": {
      "description": "The middle tier: a fuller lump that has budded — a second lobe swelling out of its upper right, and a seed of something brighter set in it. Drawn bigger by the game and tinted its tier colour; the bud is what tells it from the scrap below it by silhouette alone.",
      "add": [{"id": "bud", "at": [4.0, -3.9], "shape": {"kind": "circle", "r": 2.8}, "fill": "$smoke"}, {"id": "bud_flesh", "at": [3.9, -3.9], "shape": {"kind": "circle", "r": 1.9}, "fill": "$bone"}, {"id": "bud_gloss", "at": [3.3, -4.6], "rot": -26, "shape": {"kind": "ellipse", "rx": 0.9, "ry": 0.45}, "fill": "$white"}, {"id": "seed", "at": [-0.4, 0.6], "rot": -20, "shape": {"kind": "ellipse", "rx": 1.6, "ry": 1.1}, "fill": "$white"}],
      "set": {
        "halo.fill": "$white@0.16"
      }
    },
    "gravid": {
      "description": "The top tier: a heavy lump with three shards of something hard and bright grown up through it, the way a hive's richest tissue calcifies. Drawn biggest by the game and tinted its tier colour; the jagged crown is its silhouette, and the shards' lit faces are what the eye finds on a crowded floor.",
      "add": [{"id": "shard_a_rim", "at": [-0.6, -2.0], "rot": -12, "shape": {"kind": "poly", "points": [[-2.4, 0.49], [-1.8, -2.8], [0, -6.04], [1.95, -2.54], [2.4, 0.49]]}, "fill": "$smoke"}, {"id": "shard_b_rim", "at": [3.0, -2.2], "rot": 28, "shape": {"kind": "poly", "points": [[-2.1, 0.54], [-1.62, -2.28], [0, -5.19], [1.74, -2.07], [2.1, 0.54]]}, "fill": "$smoke"}, {"id": "shard_c_rim", "at": [-3.6, -1.8], "rot": -42, "shape": {"kind": "poly", "points": [[-1.9, 0.6], [-1.5, -1.9800000000000002], [0, -4.7700000000000005], [1.6, -1.8], [1.9, 0.6]]}, "fill": "$smoke"}, {"id": "shard_a", "at": [-0.6, -2.0], "rot": -12, "shape": {"kind": "poly", "points": [[-1.5, 0.0], [-0.9, -2.8], [0, -5.08], [1.05, -2.54], [1.5, 0.0]]}, "fill": "$white"}, {"id": "shard_a_side", "at": [-0.6, -2.0], "rot": -12, "shape": {"kind": "poly", "points": [[0, 0.16], [0, -5.08], [1.05, -2.54], [1.5, 0.0]]}, "fill": "$bone"}, {"id": "shard_b", "at": [3.0, -2.2], "rot": 28, "shape": {"kind": "poly", "points": [[-1.2, 0.0], [-0.72, -2.28], [0, -4.14], [0.84, -2.07], [1.2, 0.0]]}, "fill": "$white"}, {"id": "shard_b_side", "at": [3.0, -2.2], "rot": 28, "shape": {"kind": "poly", "points": [[0, 0.18], [0, -4.14], [0.84, -2.07], [1.2, 0.0]]}, "fill": "$bone"}, {"id": "shard_c", "at": [-3.6, -1.8], "rot": -42, "shape": {"kind": "poly", "points": [[-1.0, 0], [-0.6, -1.9800000000000002], [0, -3.6], [0.7, -1.8], [1.0, 0]]}, "fill": "$white"}, {"id": "shard_c_side", "at": [-3.6, -1.8], "rot": -42, "shape": {"kind": "poly", "points": [[0, 0.2], [0, -3.6], [0.7, -1.8], [1.0, 0]]}, "fill": "$bone"}],
