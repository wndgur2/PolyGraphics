{
  "id": "ss.draught.mine",
  "name": "Fungal Must",
  "description": "Pressed rather than drained, so it never went clear: pulp on the bottom, a haze through the middle, and spores small enough to still be drifting.",
  "tags": ["ss-draught"],
  "size": [32, 32],
  "parts": [
    { "id": "vial", "use": "ss.lib.vial", "variant": "must" },
    { "id": "haze", "at": [0, 5.4], "shape": { "kind": "ellipse", "rx": 6, "ry": 4.4 }, "fill": "$silent@ghost" },
    { "id": "pulp_a", "at": [-2.6, 7.4], "rot": 18, "shape": { "kind": "poly", "points": [[-1.5, -0.7], [-0.3, -1.3], [1.2, -0.9], [1.5, 0.3], [0.5, 1.3], [-1.1, 1]] }, "fill": "$spore.dark" },
    { "id": "pulp_b", "at": [2.2, 8.4], "rot": -34, "shape": { "kind": "poly", "points": [[-1.5, -0.7], [-0.3, -1.3], [1.2, -0.9], [1.5, 0.3], [0.5, 1.3], [-1.1, 1]] }, "fill": "$spore.dark" },
    { "id": "pulp_c", "at": [0.4, 5.4], "rot": 62, "shape": { "kind": "poly", "points": [[-1.5, -0.7], [-0.3, -1.3], [1.2, -0.9], [1.5, 0.3], [0.5, 1.3], [-1.1, 1]] }, "fill": "$spore.dark" },
    { "id": "mote_a", "at": [-3.2, 3.2], "shape": { "kind": "circle", "r": 0.5 }, "fill": "$silent" },
    { "id": "mote_b", "at": [2.9, 3], "shape": { "kind": "circle", "r": 0.45 }, "fill": "$silent" },
    { "id": "mote_c", "at": [0.2, 2.2], "shape": { "kind": "circle", "r": 0.4 }, "fill": "$silent" },
    { "id": "cap", "use": "ss.lib.vial-cap" }
  ],
  "animations": {
    "settle": {
      "description": "the haze breathes and the spores are still drifting in it",
      "duration": 2.8,
      "tracks": [
        { "part": "haze", "prop": "opacity", "keys": [[0, 0.7], [0.5, 1], [1, 0.7]] },
        { "part": "mote_a", "prop": "x", "keys": [[0, 0], [0.5, 1.2], [1, 0]] },
        { "part": "mote_b", "prop": "x", "keys": [[0, 0.5], [0.5, -0.8], [1, 0.5]] },
        { "part": "mote_c", "prop": "x", "keys": [[0, -0.6], [0.5, 0.7], [1, -0.6]] }
      ]
    }
  }
