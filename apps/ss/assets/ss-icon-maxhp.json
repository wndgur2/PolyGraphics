{
  "id": "ss.icon.maxhp",
  "name": "Max HP icon",
  "description": "Passive icon: coral heart built the classic way, two lobes over a point. Port of the hand-drawn i_maxhp from Feelers' BootScene.",
  "tags": ["ss-icon"],
  "size": [32, 32],
  "parts": [
    { "id": "tile", "shape": { "kind": "rect", "w": 32, "h": 32, "corner": 6 }, "fill": "$coral" },
    { "id": "inner", "shape": { "kind": "rect", "w": 28, "h": 28, "corner": 5 }, "fill": "$coal.dark" },
    { "id": "lobe_l", "at": [-4.5, -3], "shape": { "kind": "circle", "r": 5.5 }, "fill": "$coral" },
    { "id": "lobe_r", "at": [4.5, -3], "shape": { "kind": "circle", "r": 5.5 }, "fill": "$coral" },
    { "id": "point", "shape": { "kind": "poly", "points": [[-9.5, -0.5], [9.5, -0.5], [0, 10]] }, "fill": "$coral" }
  ]
}
