  "tags": ["ss-terrain"],
  "size": [52, 50],
  "parts": [
    { "id": "shadow", "at": [0, 20], "shape": { "kind": "ellipse", "rx": 23, "ry": 4.5 }, "fill": "$ink@0.5" },
    { "id": "jamb_outline", "at": [-17.5, 2], "mirrorX": true, "shape": { "kind": "rect", "w": 13, "h": 38 }, "fill": "$ink" },
    { "id": "jamb", "at": [-17.5, 2], "mirrorX": true, "shape": { "kind": "rect", "w": 9, "h": 34 }, "fill": "$smoke.light" },
    { "id": "springer_outline", "at": [-16, -18.5], "mirrorX": true, "shape": { "kind": "rect", "w": 16, "h": 9 }, "fill": "$ink" },
    { "id": "springer", "at": [-16, -18], "mirrorX": true, "shape": { "kind": "rect", "w": 12, "h": 6 }, "fill": "$smoke.light2" }
  ]
}
