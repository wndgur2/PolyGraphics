    {"id": "drip_b", "at": [2.6, 5.4], "shape": {"kind": "ellipse", "rx": 0.9, "ry": 1.4}, "fill": "$gold.light"},
    {"id": "cap_lit", "at": [-3.0, -2.6], "rot": -25.0, "shape": {"kind": "ellipse", "rx": 2.4, "ry": 0.9}, "fill": "$white@0.5"}
