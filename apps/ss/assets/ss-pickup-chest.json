{
  "id": "ss.pickup.chest",
  "name": "Brood cell",
  "description": "A sealed hexagonal cell the hive built and forgot. Prying one open is the only time in the run you are the thing doing the opening. Capped with wax, ribbed with chitin, and faintly lit from inside — something in there is still signalling. The cell is stretched along its flat axis, so it is never a plain hexagon, and it is the only hexagon on the floor now that the jelly is a bead rather than a plate of shell. Stretching rather than scaling keeps every slanted edge at its comb angle, so the shape still belongs to the hive's architecture. Form on the cell: the two upper-left comb edges lit and the two lower-right in shade (white and ink overlays, so a variant's fill shows through), a seam to each corner where the walls meet, two runs of wax over the cap's lower edge that take the cap's colour in every variant, a catch of light on the cap, and the dark where the cell sits on the floor.",
  "tags": ["pickup"],
  "size": [34, 24],
  "parts": [
    {"id": "glow", "at": [0, -1], "shape": {"kind": "ellipse", "rx": 14, "ry": 11}, "fill": "$gold@ghost"},
    {"id": "chest_ao", "at": [0.6, 10.6], "shape": {"kind": "ellipse", "rx": 13.0, "ry": 3.0}, "fill": "$ink@0.35"},
    {"id": "cell", "at": [0, 1], "shape": {"kind": "poly", "points": [[13.4, 0], [8.2, 9.01], [-8.2, 9.01], [-13.4, 0], [-8.2, -9.01], [8.2, -9.01]]}, "fill": "$chitin.dark", "stroke": {"color": "$ink", "width": "thin"}},
    {"id": "wall", "at": [0, 1], "shape": {"kind": "poly", "points": [[11, 0], [7, 6.93], [-7, 6.93], [-11, 0], [-7, -6.93], [7, -6.93]]}, "fill": "$chitin"},
    {"id": "cap", "at": [0, 0.4], "shape": {"kind": "poly", "points": [[8.6, 0], [5.8, 4.85], [-5.8, 4.85], [-8.6, 0], [-5.8, -4.85], [5.8, -4.85]]}, "fill": "$gold.light"},
    {"id": "cap_seam", "at": [0, 0.4], "shape": {"kind": "ring", "r": 3.4, "width": 1}, "fill": "$timber.dark"},
    {"id": "rib_l", "at": [-9.6, 1], "rot": -60, "shape": {"kind": "rect", "w": 6.4, "h": 1.4}, "fill": "$chitin.dark2"},
    {"id": "rib_r", "at": [9.6, 1], "rot": 60, "shape": {"kind": "rect", "w": 6.4, "h": 1.4}, "fill": "$chitin.dark2"},
    {"id": "edge_lit", "at": [0.0, 1.0], "shape": {"kind": "poly", "points": [[-13.4, 0.0], [-8.2, -9.01], [8.2, -9.01], [7.6, -7.6], [-7.4, -7.6], [-12.0, 0.0]]}, "fill": "$white@0.22"},
    {"id": "edge_dark", "at": [0.0, 1.0], "shape": {"kind": "poly", "points": [[13.4, 0.0], [8.2, 9.01], [-8.2, 9.01], [-7.4, 7.6], [7.6, 7.6], [12.0, 0.0]]}, "fill": "$ink@0.3"},
    {"id": "seam0", "at": [11.52, 1.0], "rot": 90.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
    {"id": "seam1", "at": [7.05, 8.75], "rot": 30.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
    {"id": "seam2", "at": [-7.05, 8.75], "rot": -30.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
    {"id": "seam3", "at": [-11.52, 1.0], "rot": 90.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
    {"id": "seam4", "at": [-7.05, -6.75], "rot": 30.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
    {"id": "seam5", "at": [7.05, -6.75], "rot": -30.0, "shape": {"kind": "rect", "w": 1.0, "h": 3.2, "corner": 0.3}, "fill": "$ink@0.35"},
