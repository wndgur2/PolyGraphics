    { "id": "inner", "at": [-1, -0.6], "shape": { "kind": "ellipse", "rx": 5, "ry": 4.2 }, "fill": "$ember" },
    { "id": "gloss", "at": [-3, -3], "rot": -26, "shape": { "kind": "ellipse", "rx": 2.4, "ry": 1.2 }, "fill": "$bone.light@heavy" },
    { "id": "stem", "at": [5.4, -4.6], "rot": 32, "shape": { "kind": "poly", "points": [[-1.4, 2.2], [-0.6, -2.6], [1.4, -2.2], [0.8, 2.4]] }, "fill": "$husk.dark" },
