        { "part": "inner", "prop": "scale", "keys": [[0, 1.04], [0.5, 0.96], [1, 1.04]] },
        { "part": "gloss", "prop": "opacity", "keys": [[0, 0.8], [0.5, 1], [1, 0.8]] }
