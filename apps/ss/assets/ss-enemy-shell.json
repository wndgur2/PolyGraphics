    16,
    12
  ],
  "parts": [
    {
      "id": "glow",
      "shape": {
        "kind": "circle",
        "r": 6.0
      },
      "fill": "$ember.light@soft"
    },
    {
      "id": "tail",
      "at": [
        -4.0,
        0.0
      ],
      "shape": {
        "kind": "ellipse",
        "rx": 5.0,
        "ry": 2.0
      },
      "fill": "$ink@heavy"
    },
    {
      "id": "outline",
      "shape": {
        "kind": "circle",
        "r": 4.6
      },
      "fill": "$ink"
    },
    {
      "id": "body",
      "shape": {
        "kind": "circle",
        "r": 3.6
      },
      "fill": "$ember"
    },
    {
      "id": "core",
      "at": [
        0.8,
        -0.6
      ],
      "shape": {
        "kind": "circle",
        "r": 1.6
      },
      "fill": "$gold.light"
    }
  ]
}
