{
  "id": "tile.ground",
  "name": "Ground tile",
  "description": "Tileable 32px floor: two-tone checker with seeded pebble and speck scatter. Deterministic — the same seed always yields the same scatter, so renders are diffable.",
  "tags": ["tile", "env"],
  "size": [32, 32],
  "parts": [
    { "id": "base", "shape": { "kind": "rect", "w": 32, "h": 32 }, "fill": "$slate.dark2" },
    { "id": "check_a", "at": [-8, -8], "shape": { "kind": "rect", "w": 16, "h": 16 }, "fill": "$slate.dark" },
    { "id": "check_b", "at": [8, 8], "shape": { "kind": "rect", "w": 16, "h": 16 }, "fill": "$slate.dark" },
    { "id": "pebbles", "repeat": { "of": { "kind": "circle", "r": 1.3 }, "count": 7, "area": [27, 27], "seed": 7, "scaleRange": [0.7, 1.4] }, "fill": "$steel@soft" },
    { "id": "specks", "repeat": { "of": { "kind": "rect", "w": 1.5, "h": 1.5 }, "count": 5, "area": [27, 27], "seed": 11, "jitterRot": true }, "fill": "$ink@heavy" }
  ]
}
