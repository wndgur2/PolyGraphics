{
  "id": "ss.sfx.whip",
  "name": "Lash",
  "description": "A cord snapping: a sawtooth thrown upward from the low end, the opposite gesture to every impact in the set, because a lash is the swing and not the landing. The sawtooth sits under a lowpass that opens as it rises, and over it is the air — noise swept up through a band, swelling into the snap and gone — because most of what a lash is, is air. The air's gain is a raw number for the reason the whoosh's is: a bandpass keeps a sliver of a noise burst. Three takes.",
  "tags": [
    "sfx",
    "weapon"
  ],
  "duration": 0.09,
  "meta": {
    "minInterval": 60
  },
  "jitter": {
    "freq": [
      0.95,
      1.16
    ]
  },
  "takes": 3,
