{
  "id": "ss.relic.armor",
  "name": "Grafted carapace plate",
  "description": "A shard of somebody else's shell, stitched on. The silhouette is deliberately asymmetric — broken off, not cut — and the seam runs across it under two chitin stitches, which is the whole reason the shape is a `poly` and not a rounded rect. Lit along the top edge, shadowed below the seam.",
  "tags": ["ss-relic"],
  "size": [32, 32],
  "parts": [
    {"id": "plate", "use": "ss.lib.relic-plate"},
    {"id": "shard_outline", "shape": {"kind": "poly", "points": [[-10.2, -7.9], [9.1, -10.2], [11.3, 2.3], [0, 11.3], [-10.7, 3.4]]}, "fill": "$ink"},
    {"id": "shard", "shape": {"kind": "poly", "points": [[-9, -7], [8, -9], [10, 2], [0, 10], [-9.5, 3]]}, "fill": "$husk.dark"},
    {"id": "lit", "shape": {"kind": "poly", "points": [[-8.6, -6.4], [7.6, -8.2], [8.2, -4.6], [-8.4, -2.8]]}, "fill": "$husk.light2"},
    {"id": "shade", "shape": {"kind": "poly", "points": [[-8.6, 2.4], [9, 0.6], [0, 9.4], [-8.4, 2.8]]}, "fill": "$husk.dark2"},
    {"id": "seam", "at": [0.5, -0.6], "rot": -7, "shape": {"kind": "rect", "w": 17.5, "h": 1.2}, "fill": "$ink@heavy"},
    {"id": "stitch_a", "at": [-4.5, -0.9], "rot": 68, "shape": {"kind": "rect", "w": 1.5, "h": 6, "corner": 0.7}, "fill": "$chitin"},
    {"id": "stitch_b", "at": [1.5, -1.6], "rot": 68, "shape": {"kind": "rect", "w": 1.5, "h": 6, "corner": 0.7}, "fill": "$chitin"}
  ],
  "variants": {
    "glyph": {
      "description": "Plate off, object only — the silhouette a collection shows for an entry not yet met.",
      "remove": ["plate"]
    }
  }
}
