    { "id": "shell", "at": [0, 11], "shape": { "kind": "ring", "r": 18, "width": 3, "from": 180, "to": 360 }, "fill": "$husk" },
    { "id": "rib_mid", "at": [0, 11], "shape": { "kind": "ring", "r": 12, "width": 3, "from": 180, "to": 360 }, "fill": "$bone.dark" },
    { "id": "rib_inner", "at": [0, 11], "shape": { "kind": "ring", "r": 6, "width": 3, "from": 180, "to": 360 }, "fill": "$bone.dark" }
  ]
