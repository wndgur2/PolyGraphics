{
  "id": "ss.enemy.brazier",
  "name": "Signal stalk",
  "description": "Not a creature — a relay. The hive grows these to repeat a scent across a level, which is why smashing one buys you quiet ground. A chitin stalk on a splayed root, a bulb organ at the top, and wisps going up where everything can smell them. The `spent` variant is the destroyed state: cracked stalk, dead bulb, no wisp. The `death` clip is the smash itself — the bulb blows and sinks, the scent going up is cut at the source, and the rings slip — where `spent` is the wreck it leaves standing.",
  "tags": ["ss-enemy", "prop"],
  "size": [32, 36],
  "meta": { "radius": 12 },
  "parts": [
    { "id": "wisp", "use": "ss.lib.wisp", "at": [0.6, -8] },
    { "id": "root_l", "at": [-5, 12.4], "shape": { "kind": "poly", "points": [[3.4, -3.6], [-1.4, 1.6], [-6, 2.6], [-5.6, 4], [1.6, 3.4], [5, -0.6]] }, "fill": "$chitin.dark" },
    { "id": "root_r", "at": [5, 12.4], "shape": { "kind": "poly", "points": [[-3.4, -3.6], [1.4, 1.6], [6, 2.6], [5.6, 4], [-1.6, 3.4], [-5, -0.6]] }, "fill": "$chitin.dark" },
    { "id": "stalk", "at": [0, 5], "shape": { "kind": "poly", "points": [[3.4, -12], [-3, -11.4], [-4.6, 10.6], [4.8, 10.6]] }, "fill": "$chitin.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "ring_a", "at": [0.2, 8.4], "shape": { "kind": "rect", "w": 9.6, "h": 1.4 }, "fill": "$chitin.dark" },
    { "id": "ring_b", "at": [0, 2.4], "shape": { "kind": "rect", "w": 8.2, "h": 1.4 }, "fill": "$chitin.dark" },
    { "id": "cup", "at": [0.2, -7.6], "shape": { "kind": "poly", "points": [[7, -3], [-6.6, -3], [-4.2, 4.8], [4.8, 4.8]] }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "organ", "use": "ss.lib.organ", "at": [0.2, -9.4], "scale": 1.05 }
  ],
  "variants": {
    "spent": {
      "description": "Smashed. The relay is dark, the cup is split and this stretch of hive has gone deaf — which is exactly why you broke it.",
      "set": {
        "organ.variant": "dead",
        "stalk.fill": "$chitin.dark",
        "cup.fill": "$carapace",
        "wisp.opacity": 0
      },
      "add": [
        { "id": "break", "at": [1.4, -2.6], "rot": 68, "shape": { "kind": "poly", "points": [[-5.4, 0], [-1.6, -1.4], [1.6, 0.8], [5.4, -0.6], [5.4, 0.6], [1.5, 1.8], [-1.7, 0.4]] }, "fill": "$dead" }
      ]
    }
  },
  "animations": {
    "broadcast": {
      "description": "the bulb swells on a slow cycle and the wisp climbs",
      "duration": 2.6,
      "tracks": [
        { "part": "organ", "prop": "scale", "keys": [[0, 0.98], [0.5, 1.14], [1, 0.98]] },
        { "part": "wisp", "prop": "y", "keys": [[0, 0], [1, -4]], "ease": "linear" },
        { "part": "cup", "prop": "y", "keys": [[0, 0], [0.5, -0.5], [1, 0]] }
      ]
    },
    "death": {
      "description": "a relay being smashed rather than a body dying: the bulb blows out in one flare and sinks onto the stalk, the scent going up is cut off at the source and thins away, the rings slip on a cracking stalk and the splayed root gives",
      "duration": 0.55,
      "tracks": [
        {"part": "organ", "prop": "scale", "keys": [[0, 1], [0.08, 2.3], [0.3, 1.45], [0.62, 0.2], [0.84, 0.04], [1, 0.04]]},
        {"part": "organ", "prop": "opacity", "keys": [[0, 1], [0.34, 1], [0.68, 0.16], [0.85, 0], [1, 0]]},
        {"part": "organ", "prop": "y", "keys": [[0, 0], [0.1, -0.6], [0.6, 2.79], [0.85, 3.4], [1, 3.4]]},
        {"part": "wisp", "prop": "y", "keys": [[0, 0], [0.2, -6], [0.85, -14], [1, -14]]},
        {"part": "wisp", "prop": "scale", "keys": [[0, 1], [0.2, 1.35], [0.85, 0.45], [1, 0.45]]},
        {"part": "wisp", "prop": "opacity", "keys": [[0, 1], [0.2, 0.7], [0.6, 0.14], [0.85, 0], [1, 0]]},
        {"part": "cup", "prop": "rot", "keys": [[0, 0], [0.1, -4.55], [0.55, 11.05], [0.85, 13], [1, 13]]},
        {"part": "cup", "prop": "y", "keys": [[0, 0], [0.1, -0.8], [0.6, 3.28], [0.85, 4], [1, 4]]},
        {"part": "stalk", "prop": "rot", "keys": [[0, 0], [0.1, -3.5], [0.55, 8.5], [0.85, 10], [1, 10]]},
        {"part": "ring_a", "prop": "rot", "keys": [[0, 0], [0.16, 3], [0.85, -9], [1, -9]]},
        {"part": "ring_b", "prop": "rot", "keys": [[0, 0], [0.16, -4], [0.85, 11], [1, 11]]},
        {"part": "ring_b", "prop": "y", "keys": [[0, 0], [0.4, 1.2], [0.85, 2], [1, 2]]},
        {"part": "root_l", "prop": "rot", "keys": [[0, 0], [0.1, 8], [0.55, -16], [0.85, -17.92], [1, -17.92]]},
        {"part": "root_l", "prop": "x", "keys": [[0, 0], [0.6, -1.4], [0.85, -1.8], [1, -1.8]]},
        {"part": "root_r", "prop": "rot", "keys": [[0, 0], [0.1, -8], [0.55, 16], [0.85, 17.92], [1, 17.92]]},
        {"part": "root_r", "prop": "x", "keys": [[0, 0], [0.6, 1.4], [0.85, 1.8], [1, 1.8]]}
      ]
    }
  }
}
