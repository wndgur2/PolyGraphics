      "set": {
        "barb.at": [-3.23, 1.05],
        "barb_core.at": [-3.8, 1.23],
        "barb_organ.at": [-6.24, 1.82]
      }
    },
    "spent": {
      "description": "The bow after it has let go, left standing where it loosed. Ribs fallen open past rest, tendon hanging off the angle it was held at and gone dark, scent organ down to `faint` — it has nothing left to throw and about a second before it stops signalling. Drawn so the field keeps a record of where a volley came from.",
