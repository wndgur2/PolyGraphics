{
  "id": "ss.proj.ring",
  "name": "Frost nova",
  "description": "The one thing in the arsenal that isn't scavenged — cold thrown outward in a ring, the survivor's own answer to being surrounded. Three concentric bands and nothing else: the weapon code scales this sprite by `wave.r / 62`, so anything with a shape of its own is blown up with it, and the studs that used to sit on the rim arrived on screen as gems stuck to a hoop. Geometry is load-bearing — the 128px canvas and the 60px rim radius must not move. Kept near-white so any runtime tint still reads.",
  "tags": [
    "ss-proj",
    "aoe"
  ],
  "size": [
    128,
    128
  ],
  "meta": {
    "radius": 62
  },
  "parts": [
    {
      "id": "wash",
      "shape": {
        "kind": "ring",
        "r": 55,
        "width": 13
      },
      "fill": "$frost@0.16"
    },
    {
      "id": "rim",
      "shape": {
        "kind": "ring",
        "r": 60,
        "width": 5.5
      },
      "fill": "$white@0.9"
    },
    {
      "id": "inner",
      "shape": {
        "kind": "ring",
        "r": 47,
        "width": 2
      },
      "fill": "$frost@soft"
    }
  ],
  "animations": {
    "play": {
      "description": "the rim snaps outward and the wash follows it out",
      "duration": 0.5,
      "tracks": [
        {
          "part": "rim",
          "prop": "scale",
          "keys": [
            [
              0,
              0.55
            ],
            [
              1,
              1
            ]
          ],
          "ease": "backOut"
        },
        {
          "part": "wash",
          "prop": "opacity",
          "keys": [
            [
              0,
              1
            ],
            [
              0.6,
              0.7
            ],
            [
              1,
              0
            ]
          ]
        },
        {
          "part": "inner",
          "prop": "scale",
          "keys": [
            [
              0,
              0.4
            ],
            [
              1,
              1.05
            ]
          ],
          "ease": "backOut"
        }
      ]
    }
  }
}