{
  "id": "ss.lib.wisp",
  "name": "Scent wisp",
  "description": "Pheromone leaking upward — three blobs thinning as they rise. Marks anything that is broadcasting: stalks, vents, and the trail a flier leaves behind. The player never has one.",
  "tags": ["ss-lib"],
  "size": [12, 20],
  "anchor": [0.5, 0.9],
  "parts": [
    { "id": "w1", "at": [0.4, -3.4], "shape": { "kind": "ellipse", "rx": 2.1, "ry": 2.6 }, "fill": "$pheromone@soft" },
    { "id": "w2", "at": [-1.2, -8.2], "shape": { "kind": "ellipse", "rx": 1.6, "ry": 2 }, "fill": "$pheromone@0.24" },
    { "id": "w3", "at": [0.8, -12.6], "shape": { "kind": "ellipse", "rx": 1.1, "ry": 1.4 }, "fill": "$pheromone@ghost" }
  ],
  "animations": {
    "rise": {
      "description": "blobs drift up and thin out, staggered",
      "duration": 2.4,
      "tracks": [
        { "part": "w1", "prop": "y", "keys": [[0, 1.5], [1, -3]] },
        { "part": "w2", "prop": "y", "keys": [[0, 1], [1, -3.5]] },
        { "part": "w3", "prop": "opacity", "keys": [[0, 0.9], [0.6, 0.4], [1, 0]] }
      ]
    }
  }
}
