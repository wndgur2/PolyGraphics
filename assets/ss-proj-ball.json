{
  "id": "ss.proj.ball",
  "name": "Chained head",
  "description": "A Soldier's head-plate packed solid and swung on a cord. Heavy, ridged, and about as far from subtle as this arsenal gets. Its geometry is load-bearing: the weapon code scales this sprite by `ballR / 14`, so the 28px canvas and ~13.5 body radius must stay as they are.",
  "tags": ["ss-proj", "melee"],
  "size": [28, 28],
  "meta": { "radius": 13.5 },
  "parts": [
    { "id": "outline", "shape": { "kind": "circle", "r": 13.5 }, "fill": "$ink" },
    { "id": "body", "shape": { "kind": "circle", "r": 11.4 }, "fill": "$chitin.dark" },
    { "id": "ridge_a", "at": [0, -4.4], "shape": { "kind": "ring", "r": 8.4, "width": 1.8, "from": 200, "to": 340 }, "fill": "$husk.dark" },
    { "id": "ridge_b", "at": [0, 1], "shape": { "kind": "ring", "r": 9.4, "width": 1.6, "from": 195, "to": 345 }, "fill": "$husk.dark" },
    { "id": "boss_plate", "at": [-2.6, -2.6], "shape": { "kind": "ngon", "sides": 6, "r": 5, "rot": 30 }, "fill": "$chitin" },
    { "id": "gleam", "at": [-4.4, -4.6], "rot": -30, "shape": { "kind": "ellipse", "rx": 2.8, "ry": 1.3 }, "fill": "$frost.light@heavy" },
    { "id": "stud_a", "at": [6.4, 4.4], "shape": { "kind": "circle", "r": 1.6 }, "fill": "$husk" },
    { "id": "stud_b", "at": [1.4, 8.4], "shape": { "kind": "circle", "r": 1.3 }, "fill": "$husk.dark" }
  ]
}
