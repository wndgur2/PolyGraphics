{
  "id": "ss.enemy.brute",
  "name": "Soldier",
  "description": "The caste that gets sent when a Tracker's call is answered. One heavy plated dome, two shearing mandibles and a pair of organs broadcasting the kill order. Big, bright and almost featureless on purpose — the tank has to read as mass from across the screen, so it is a slab of chitin rather than a study of one.",
  "tags": ["ss-enemy", "tank"],
  "size": [44, 44],
  "meta": { "radius": 16 },
  "parts": [
    { "id": "leg_b", "at": [-9, 11.4], "rot": 20, "shape": { "kind": "rect", "w": 5.4, "h": 11, "corner": 2.6 }, "fill": "$carapace.dark" },
    { "id": "leg_f", "at": [7.4, 11], "rot": -18, "shape": { "kind": "rect", "w": 5.4, "h": 11, "corner": 2.6 }, "fill": "$carapace.dark" },
    { "id": "shell", "at": [-1, 0], "shape": { "kind": "poly", "points": [[14, -2], [10, -10.4], [0, -14], [-11, -11], [-16, -2.4], [-13.4, 7], [-2, 10.4], [10, 7.4]] }, "fill": "$chitin", "stroke": { "color": "$ink", "width": "bold" } },
    { "id": "plate", "at": [-2.4, -3.6], "shape": { "kind": "poly", "points": [[9.4, -1.4], [4.4, -7.4], [-4.6, -8], [-9.6, -2], [-6.6, 4.4], [4.4, 4.6]] }, "fill": "$chitin.light2" },
    { "id": "ridge", "at": [-3, -8.4], "shape": { "kind": "rect", "w": 17, "h": 2.2, "corner": 1 }, "fill": "$husk" },
    { "id": "maw", "at": [13.6, 2.6], "shape": { "kind": "poly", "points": [[3.4, -5], [-4, -2.6], [-4, 2.8], [3.6, 5.2], [1.6, 0]] }, "fill": "$ink" },
    { "id": "mandible_up", "at": [14.4, -0.4], "shape": { "kind": "poly", "points": [[-1.4, -2.6], [6.6, -5.4], [9.6, -2], [3.6, -0.6]] }, "fill": "$husk", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "mandible_dn", "at": [14.4, 5], "shape": { "kind": "poly", "points": [[-1.4, 2.6], [6.6, 5.4], [9.6, 2], [3.6, 0.6]] }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "organ", "use": "ss.lib.organ", "at": [-3.4, -6.4], "scale": 0.72 },
    { "id": "organ_rear", "use": "ss.lib.organ", "at": [-12, -2.4], "scale": 0.5 }
  ],
  "variants": {
    "elite": {
      "description": "A war caste: bleached plates, a spined ridge and a third organ. When this one broadcasts, the level turns around.",
      "scale": 1.25,
      "set": { "plate.fill": "$husk", "ridge.fill": "$bone.light", "organ.scale": 0.88 },
      "add": [
        { "id": "spines", "at": [-2, -12.4], "shape": { "kind": "poly", "points": [[-9, 2], [-6.8, -3], [-4.4, 1.2], [-1.6, -4.2], [1, 0.6], [4, -3.4], [6, 1.4], [8, 2.4]] }, "fill": "$husk" },
        { "id": "organ_top", "use": "ss.lib.organ", "at": [6, -9], "scale": 0.46 }
      ]
    }
  },
  "animations": {
    "stomp": {
      "description": "slow heavy gait, plates settling a beat behind the shell",
      "duration": 1.3,
      "tracks": [
        { "part": "shell", "prop": "y", "keys": [[0, 1], [0.5, -0.8], [1, 1]] },
        { "part": "plate", "prop": "y", "keys": [[0, -3], [0.5, -4.4], [1, -3]] },
        { "part": "leg_b", "prop": "rot", "keys": [[0, 20], [0.5, 32], [1, 20]] },
        { "part": "leg_f", "prop": "rot", "keys": [[0, -26], [0.5, -14], [1, -26]] },
        { "part": "mandible_up", "prop": "rot", "keys": [[0, 0], [0.5, -10], [1, 0]] },
        { "part": "mandible_dn", "prop": "rot", "keys": [[0, 0], [0.5, 10], [1, 0]] }
      ]
    }
  }
}
