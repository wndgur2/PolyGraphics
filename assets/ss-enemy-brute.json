    { "id": "mandible_dn", "at": [10.4, 4.6], "rot": -6, "shape": { "kind": "poly", "points": [[-1.4, 2.4], [4.6, 5.2], [8.6, 2.8], [7.2, 0.2], [3.6, 1.2], [-0.6, -1.6]] }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "antenna", "use": "ss.lib.antenna", "at": [10.4, -3.6], "rot": -12, "scale": 0.8 },
