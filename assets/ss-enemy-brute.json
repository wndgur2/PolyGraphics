    { "id": "leg_far_f", "at": [5, 3], "rot": -18, "scale": 0.85, "shape": { "kind": "poly", "points": [[2.4, 0], [5, 5], [4.4, 11.6], [1, 11.6], [1.2, 5.4], [-2.2, 1]] }, "fill": "$carapace" },
