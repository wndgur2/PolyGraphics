    { "id": "leg_f", "at": [6.2, 4.2], "rot": -24, "shape": { "kind": "poly", "points": [[2.4, 0], [5, 5], [4.4, 11.6], [1, 11.6], [1.2, 5.4], [-2.2, 1]] }, "fill": "$carapace.light" },
