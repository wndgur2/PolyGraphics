    { "id": "head", "shape": { "kind": "poly", "points": [[0, -10], [8, 0], [-8, 0]] }, "fill": "$frost" },
    { "id": "stem", "at": [0, 4.5], "shape": { "kind": "rect", "w": 6, "h": 11 }, "fill": "$frost" }
  ]
}
