{
  "id": "ss.enemy.skeleton",
  "name": "Molt",
  "description": "Nobody is inside. A shed carapace split down the front, held upright only by the signal rattling around in it. Cold pale grey where the Husk is warm bone, and the split is the whole silhouette: one bright shell with a dark seam of nothing lit from within.",
  "tags": ["ss-enemy", "shell"],
  "size": [32, 32],
  "meta": { "radius": 10 },
  "parts": [
    { "id": "leg_far", "at": [-4, 9.4], "rot": 12, "shape": { "kind": "rect", "w": 4.2, "h": 10, "corner": 2 }, "fill": "$slate.light" },
    { "id": "leg", "at": [4.2, 9.4], "rot": -10, "shape": { "kind": "rect", "w": 4.6, "h": 10.4, "corner": 2.2 }, "fill": "$steel.dark" },
    { "id": "gap_glow", "at": [0, -0.5], "shape": { "kind": "ellipse", "rx": 4.6, "ry": 10 }, "fill": "$pheromone@soft" },
    { "id": "shell_l", "at": [-5, -0.6], "shape": { "kind": "poly", "points": [[2.4, -10.4], [-3, -8], [-5.4, -0.8], [-3.6, 6], [1.6, 8.8], [3.4, 1.2]] }, "fill": "$steel.light2", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "shell_r", "at": [5.2, -0.4], "shape": { "kind": "poly", "points": [[-2.2, -10.6], [3.2, -7.8], [5.4, -0.6], [3.4, 6.2], [-1.8, 8.6], [-3.2, 1]] }, "fill": "$steel.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "seam", "shape": { "kind": "rect", "w": 2.6, "h": 19 }, "fill": "$ink" },
    { "id": "rib_l", "at": [-5.4, -3.4], "rot": -6, "shape": { "kind": "rect", "w": 7.4, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_l2", "at": [-5.4, 2.4], "rot": 6, "shape": { "kind": "rect", "w": 7, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_r", "at": [5.6, -3.2], "rot": 6, "shape": { "kind": "rect", "w": 7.4, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_r2", "at": [5.6, 2.6], "rot": -6, "shape": { "kind": "rect", "w": 7, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "crown", "at": [0, -11.6], "shape": { "kind": "poly", "points": [[8, 0.8], [4.6, -3.2], [0, -4.8], [-4.6, -3.2], [-8, 0.8], [-6.4, 3.6], [0, 2.4], [6.4, 3.6]] }, "fill": "$steel.light2", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "crown_gap", "at": [0, -10.8], "shape": { "kind": "rect", "w": 2.6, "h": 6.4 }, "fill": "$ink" },
    { "id": "organ", "use": "ss.lib.organ", "variant": "faint", "at": [0.2, -1.6], "scale": [0.5, 0.78] }
  ],
  "variants": {
    "elite": {
      "description": "The shell answered louder than it should have — the seam forced wide open, and the signal inside is no longer faint.",
      "scale": 1.3,
      "set": { "shell_l.at": [-6.6, -0.6], "shell_r.at": [6.8, -0.4], "gap_glow.scale": [1.5, 1.1], "seam.scale": [2.2, 1] },
      "add": [{ "id": "organ_bright", "use": "ss.lib.organ", "at": [0.2, 5], "scale": [0.46, 0.62] }]
    }
  },
  "animations": {
    "rattle": {
      "description": "the two halves breathe apart and the light between them swells",
      "duration": 1.4,
      "tracks": [
        { "part": "shell_l", "prop": "x", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "shell_r", "prop": "x", "keys": [[0, 0], [0.5, 1.4], [1, 0]] },
        { "part": "gap_glow", "prop": "opacity", "keys": [[0, 0.45], [0.5, 1], [1, 0.45]] },
        { "part": "crown", "prop": "y", "keys": [[0, 0], [0.5, -1], [1, 0]] }
      ]
    }
  }
}
