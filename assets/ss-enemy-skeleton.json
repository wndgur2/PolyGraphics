{
  "id": "ss.enemy.skeleton",
  "name": "Molt",
  "description": "Nobody is inside. A shed carapace, split down the front, that the hive keeps calling until it answers — the signal rattling around an empty shell is the only thing holding it upright. Cold grey where the Husk is warm bone: this one was never bleached by anything, it was simply left. The split is the silhouette, a dark seam of nothing lit faintly from within.",
  "tags": ["ss-enemy", "shell"],
  "size": [32, 32],
  "meta": { "radius": 10 },
  "parts": [
    { "id": "leg_far", "at": [-3.4, 7], "rot": 14, "scale": 0.9, "shape": { "kind": "poly", "points": [[1.6, 0], [3, 4.4], [2.6, 8.6], [0.6, 8.6], [0.6, 4.6], [-1.4, 0.6]] }, "fill": "$slate" },
    { "id": "leg_far2", "at": [3.6, 7], "rot": -12, "scale": 0.9, "shape": { "kind": "poly", "points": [[1.6, 0], [3, 4.4], [2.6, 8.6], [0.6, 8.6], [0.6, 4.6], [-1.4, 0.6]] }, "fill": "$slate" },
    { "id": "gap_glow", "at": [0, -0.5], "shape": { "kind": "ellipse", "rx": 4, "ry": 9.5 }, "fill": "$pheromone@soft" },
    { "id": "hollow", "shape": { "kind": "poly", "points": [[2, -10.4], [-1.8, -9.4], [-2.6, -1], [-1.4, 6.6], [1.8, 7.4], [2.8, -0.6]] }, "fill": "$dead" },
    { "id": "shell_l", "at": [-4.6, -0.6], "shape": { "kind": "poly", "points": [[2.6, -9], [-2, -7.4], [-4.6, -1.4], [-3.4, 5], [1.4, 8], [3.4, 1.4]] }, "fill": "$steel.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "shell_r", "at": [4.8, -0.4], "shape": { "kind": "poly", "points": [[-2.4, -9.2], [2.2, -7.2], [4.6, -1.2], [3.2, 5.2], [-1.6, 7.8], [-3.2, 1.2]] }, "fill": "$steel", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "rib_l1", "at": [-5, -4.4], "rot": -8, "shape": { "kind": "rect", "w": 6.4, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "rib_l2", "at": [-5.6, -0.6], "rot": -2, "shape": { "kind": "rect", "w": 7, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "rib_l3", "at": [-5, 3.2], "rot": 6, "shape": { "kind": "rect", "w": 6, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "rib_r1", "at": [5.2, -4.2], "rot": 8, "shape": { "kind": "rect", "w": 6.4, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "rib_r2", "at": [5.8, -0.4], "rot": 2, "shape": { "kind": "rect", "w": 7, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "rib_r3", "at": [5.2, 3.4], "rot": -6, "shape": { "kind": "rect", "w": 6, "h": 1.1 }, "fill": "$slate.light" },
    { "id": "crown", "at": [0, -11.2], "shape": { "kind": "poly", "points": [[7.6, 0.6], [4.4, -3], [0, -4.4], [-4.4, -3], [-7.6, 0.6], [-6.2, 3.4], [0, 2.2], [6.2, 3.4]] }, "fill": "$steel.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "crown_gap", "at": [0, -10.4], "shape": { "kind": "poly", "points": [[1.5, -3.6], [-1.5, -3.6], [-1.1, 2.6], [1.1, 2.6]] }, "fill": "$dead" },
    { "id": "collar_l", "at": [-6.4, -8.2], "rot": -28, "shape": { "kind": "poly", "points": [[3, -1.6], [-1.6, -2.6], [-3.6, 1.4], [1.6, 2.4]] }, "fill": "$slate.light" },
    { "id": "collar_r", "at": [6.6, -8], "rot": 28, "shape": { "kind": "poly", "points": [[-3, -1.6], [1.6, -2.6], [3.6, 1.4], [-1.6, 2.4]] }, "fill": "$slate" },
    { "id": "organ", "use": "ss.lib.organ", "variant": "faint", "at": [0.2, -1.6], "scale": [0.42, 0.72] }
  ],
  "variants": {
    "elite": {
      "description": "The shell answered louder than it should have — the seam forced wide open, and the signal inside is no longer faint.",
      "scale": 1.3,
      "set": {
        "shell_l.at": [-6.4, -0.6],
        "shell_r.at": [6.6, -0.4],
        "gap_glow.scale": [1.45, 1.1],
        "crown_gap.scale": [2, 1]
      },
      "add": [
        { "id": "organ_bright", "use": "ss.lib.organ", "at": [0.2, 4.2], "scale": [0.42, 0.58] }
      ]
    }
  },
  "animations": {
    "rattle": {
      "description": "the two halves breathe apart and the light between them swells",
      "duration": 1.4,
      "tracks": [
        { "part": "shell_l", "prop": "x", "keys": [[0, 0], [0.5, -1.3], [1, 0]] },
        { "part": "shell_r", "prop": "x", "keys": [[0, 0], [0.5, 1.3], [1, 0]] },
        { "part": "gap_glow", "prop": "opacity", "keys": [[0, 0.45], [0.5, 1], [1, 0.45]] },
        { "part": "crown", "prop": "y", "keys": [[0, 0], [0.5, -1], [1, 0]] },
        { "part": "collar_l", "prop": "rot", "keys": [[0, -28], [0.5, -35], [1, -28]] },
        { "part": "collar_r", "prop": "rot", "keys": [[0, 28], [0.5, 35], [1, 28]] }
      ]
    }
  }
}
