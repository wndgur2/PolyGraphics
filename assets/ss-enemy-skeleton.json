{
  "id": "ss.enemy.skeleton",
  "name": "Molt",
  "description": "Nobody is inside. A shed carapace split down the front, held upright only by the signal rattling around in it. Cold pale grey where the Husk is warm bone, and the split is the whole silhouette — but it is a front, so it points where the shell is walking: the big blank back half trails, a narrow lit plate leads, and the hood juts out over the seam. One bright shell with a dark seam of nothing lit from within, aimed.",
  "tags": ["ss-enemy", "shell"],
  "size": [32, 32],
  "meta": { "radius": 10 },
  "parts": [
    { "id": "leg_far", "at": [-5.8, 9.6], "rot": 18, "shape": { "kind": "rect", "w": 4.2, "h": 10, "corner": 2 }, "fill": "$slate.light" },
    { "id": "leg", "at": [4.4, 9.4], "rot": -14, "shape": { "kind": "rect", "w": 4.6, "h": 10.4, "corner": 2.2 }, "fill": "$steel.dark" },
    { "id": "gap_glow", "at": [2.6, 1.6], "shape": { "kind": "ellipse", "rx": 4.2, "ry": 6.2 }, "fill": "$pheromone@soft" },
    { "id": "shell_l", "at": [-4.4, -0.6], "shape": { "kind": "poly", "points": [[5.2, -9.4], [-0.2, -10], [-4.6, -5.4], [-6, 1.2], [-3.6, 7.6], [1.8, 10.2], [6.2, 5.2], [5.8, -2.2]] }, "fill": "$steel", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "shell_r", "at": [6.6, 1], "shape": { "kind": "poly", "points": [[-2.8, -4.8], [1.6, -3.4], [3.6, 0.4], [1, 5.6], [-2.6, 7.6], [-3.4, 0.6]] }, "fill": "$steel.light2", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "seam", "at": [2.6, 1.6], "shape": { "kind": "rect", "w": 2.4, "h": 14 }, "fill": "$ink" },
    { "id": "rib_l", "at": [-4.8, -4], "rot": -8, "shape": { "kind": "rect", "w": 8.4, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_l2", "at": [-4.6, 2.4], "rot": 8, "shape": { "kind": "rect", "w": 8.2, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_r", "at": [6.8, -1.4], "rot": 10, "shape": { "kind": "rect", "w": 4.4, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "rib_r2", "at": [6.4, 3.6], "rot": -8, "shape": { "kind": "rect", "w": 3.8, "h": 1.4 }, "fill": "$slate.light" },
    { "id": "crown", "at": [1.2, -11.4], "shape": { "kind": "poly", "points": [[-7.8, 1.8], [-4.6, -3.6], [0.8, -3.2], [6, -0.4], [9.8, 4.4], [5.6, 4.6], [-0.4, 2.8], [-6.4, 4.6]] }, "fill": "$steel.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "crown_gap", "at": [2.6, -11], "rot": 10, "shape": { "kind": "rect", "w": 2.4, "h": 6 }, "fill": "$ink" },
    { "id": "organ", "use": "ss.lib.organ", "variant": "faint", "at": [2.6, 1], "scale": [0.5, 0.7] }
  ],
  "variants": {
    "elite": {
      "description": "The shell answered louder than it should have — the seam forced wide open, and the signal inside is no longer faint.",
      "scale": 1.3,
      "set": { "shell_l.at": [-6, -0.6], "shell_r.at": [8, 1], "gap_glow.scale": [1.4, 1.1], "seam.scale": [2, 1] },
      "add": [{ "id": "organ_bright", "use": "ss.lib.organ", "at": [2.6, 6.4], "scale": [0.46, 0.6] }]
    }
  },
  "animations": {
    "rattle": {
      "description": "the two halves breathe apart and the light between them swells — the front plate leads, so the shell nods the way it is going",
      "duration": 1.4,
      "tracks": [
        { "part": "shell_l", "prop": "x", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "shell_r", "prop": "x", "keys": [[0, 0], [0.5, 1.4], [1, 0]] },
        { "part": "gap_glow", "prop": "opacity", "keys": [[0, 0.45], [0.5, 1], [1, 0.45]] },
        { "part": "crown", "prop": "y", "keys": [[0, 0], [0.5, -1], [1, 0]] },
        { "part": "crown", "prop": "rot", "keys": [[0, 0], [0.5, 4], [1, 0]] }
      ]
    }
  }
}
