{
  "id": "fx.muzzle",
  "name": "Muzzle flash",
  "description": "Ranged-attack muzzle cone: gold outer wedge, ember inner wedge, anchored at the barrel (left edge) so it points +x. Port of Cellspire's Glob.muzzle verb.",
  "tags": ["fx", "ranged"],
  "size": [28, 24],
  "anchor": [0.12, 0.5],
  "parts": [
    { "id": "cone", "shape": { "kind": "wedge", "r": 13, "from": -24, "to": 24 }, "fill": "$gold" },
    { "id": "cone_in", "shape": { "kind": "wedge", "r": 8.5, "from": -16, "to": 16 }, "fill": "$ember" },
    { "id": "spark", "at": [14, 0], "shape": { "kind": "star", "points": 4, "r": 3.4, "r2": 1.2 }, "fill": "$bone" }
  ],
  "animations": {
    "play": {
      "description": "kick out and vanish fast",
      "duration": 0.16,
      "tracks": [
        { "part": "cone", "prop": "scale", "keys": [[0, 0.5], [0.45, 1.05], [1, 0.9]], "ease": "backOut" },
        { "part": "cone_in", "prop": "opacity", "keys": [[0, 1], [1, 0]] },
        { "part": "spark", "prop": "x", "keys": [[0, 0], [1, 5]], "ease": "linear" }
      ]
    }
  }
}
