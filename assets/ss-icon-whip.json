{
  "id": "ss.icon.whip",
  "name": "Lash icon",
  "description": "UI slot icon for the mandible lash. Composes the real `ss.proj.slash` arc via `use` at a quarter scale, so retuning the weapon's sweep restyles its icon in the same edit.",
  "tags": ["ss-icon"],
  "size": [32, 32],
  "parts": [
    { "id": "tile", "shape": { "kind": "rect", "w": 32, "h": 32, "corner": 6 }, "fill": "$husk" },
    { "id": "inner", "shape": { "kind": "rect", "w": 28, "h": 28, "corner": 5 }, "fill": "$coal.dark" },
    { "id": "glyph", "use": "ss.proj.slash", "at": [-5, 0], "scale": 0.26 }
  ],
  "variants": {
    "evolved": {
      "description": "Gold-rimmed evolved twin (the old i_whip_evo).",
      "set": { "tile.fill": "$gold" }
    }
  }
}
