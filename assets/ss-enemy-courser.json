{
  "id": "ss.enemy.courser",
  "name": "Courser",
  "description": "The caste that answers a Chorus. Everything else in the hive walks toward you; this one holds still, reads the air with a pair of feelers, and then commits the whole body along the line it read. Drawn as what it is — a running beetle: fused elytra split down the seam, a plated pronotum, sprinter's legs swept out of the way, and the ram it hits with drawn as the jaws it actually is. The feelers are the tell, and they are the only soft thing on it. Crimson because nothing else in the hive is: Chorus is amber, Matriarch is violet, and a body that crosses the field in half a second has to be told apart in the half second it is doing it. Drawn facing +x, the game flips it. Gameplay radius 44.",
  "tags": ["ss-enemy", "boss"],
  "size": [112, 96],
  "meta": { "radius": 44 },
  "parts": [
    { "id": "feeler_far", "at": [33, -4], "rot": 30, "shape": { "kind": "rect", "w": 3.2, "h": 30, "corner": 1.6 }, "fill": "$husk.dark2" },
    { "id": "feeler", "at": [39, -5], "rot": 52, "shape": { "kind": "rect", "w": 3.8, "h": 36, "corner": 1.9 }, "fill": "$husk" },
    { "id": "leg_far_b", "at": [-28, 20], "rot": 36, "shape": { "kind": "rect", "w": 5.4, "h": 19, "corner": 2.6 }, "fill": "$blood.dark2" },
    { "id": "leg_far_f", "at": [8, 18], "rot": -24, "shape": { "kind": "rect", "w": 5.4, "h": 19, "corner": 2.6 }, "fill": "$blood.dark2" },
    { "id": "leg_b", "at": [-26, 24], "rot": 32, "shape": { "kind": "rect", "w": 6.4, "h": 24, "corner": 3.2 }, "fill": "$blood.dark" },
    { "id": "leg_m", "at": [-6, 26], "rot": 8, "shape": { "kind": "rect", "w": 6.4, "h": 24, "corner": 3.2 }, "fill": "$blood.dark" },
    { "id": "leg_f", "at": [14, 22], "rot": -26, "shape": { "kind": "rect", "w": 6.4, "h": 24, "corner": 3.2 }, "fill": "$blood.dark" },
    { "id": "elytra", "shape": { "kind": "poly", "points": [[22, 0], [16, -16], [-4, -23], [-26, -22], [-45, -10], [-45, 10], [-26, 22], [-4, 23], [16, 16]] }, "fill": "$blood.dark2", "stroke": { "color": "$ink", "width": "heavy" } },
    { "id": "case_up", "at": [-11, -3], "shape": { "kind": "poly", "points": [[29, -1], [22, -11], [6, -17], [-13, -16], [-29, -7], [-29, -1]] }, "fill": "$blood" },
    { "id": "case_dn", "at": [-11, 3], "shape": { "kind": "poly", "points": [[29, 1], [22, 11], [6, 17], [-13, 16], [-29, 7], [-29, 1]] }, "fill": "$blood.dark" },
    { "id": "seam", "at": [-12, 0], "shape": { "kind": "rect", "w": 63, "h": 2.6, "corner": 1.3 }, "fill": "$ink" },
    { "id": "pronotum", "at": [24, 0], "shape": { "kind": "poly", "points": [[8, -10], [-4, -14], [-6, 0], [-4, 14], [8, 10], [5, 0]] }, "fill": "$husk", "stroke": { "color": "$ink", "width": "bold" } },
    { "id": "head", "at": [36, 1], "shape": { "kind": "circle", "r": 11.5 }, "fill": "$blood.dark2", "stroke": { "color": "$ink", "width": "bold" } },
    { "id": "eye", "at": [39, -3], "shape": { "kind": "circle", "r": 5.2 }, "fill": "$dead" },
    { "id": "eye_glow", "at": [39, -3], "shape": { "kind": "circle", "r": 3.2 }, "fill": { "gradient": "radial", "from": [0.5, 0.5], "stops": [[0, "$pheromone.light"], [1, "$pheromone@0.1"]] } },
    { "id": "maw", "at": [45, 4], "shape": { "kind": "poly", "points": [[5, -6], [-6, -4], [-6, 4], [5, 7], [1, 0]] }, "fill": "$ink" },
    { "id": "mandible_up", "at": [45, -2], "shape": { "kind": "poly", "points": [[-3, -3.4], [7, -8.6], [12, -2.6], [3.4, 0.4]] }, "fill": "$bone.light", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "mandible_dn", "at": [45, 7], "shape": { "kind": "poly", "points": [[-3, 3.4], [7, 8.6], [12, 2.6], [3.4, -0.4]] }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "organ", "use": "ss.lib.organ", "at": [-18, -9], "scale": 1.05 }
  ],
  "variants": {
    "enraged": {
      "description": "Phase two, and the value structure inverts: the shell that was dark goes hot, the wing cases under it go black, the seam splits open on what is inside, the jaws burn white, and the feelers stand fully up and stay there. It has stopped reading the air, because it has stopped needing to.",
      "scale": 1.08,
      "set": {
        "elytra.fill": "$blood",
        "case_up.fill": "$dead",
        "case_dn.fill": "$dead",
        "pronotum.fill": "$blood.dark2",
        "head.fill": "$dead",
        "mandible_up.fill": "$white",
        "mandible_dn.fill": "$bone.light",
        "feeler.rot": 70,
        "feeler_far.rot": 48,
        "feeler.fill": "$bone.light",
        "feeler_far.fill": "$husk",
        "organ.scale": 1.28,
        "eye_glow.fill": { "gradient": "radial", "from": [0.5, 0.5], "stops": [[0, "$white"], [1, "$pheromone@soft"]] }
      },
      "add": [
        { "id": "split", "at": [-9, 0], "shape": { "kind": "poly", "points": [[-31, -1], [-11, -3.4], [8, -1.8], [28, -3.2], [28, 3.2], [8, 2.2], [-11, 3.6]] }, "fill": "$pheromone.dark" },
        { "id": "split_core", "at": [-9, 0], "shape": { "kind": "poly", "points": [[-28, -0.4], [-10, -1.8], [7, -0.8], [26, -1.7], [26, 1.7], [7, 1.2], [-10, 2]] }, "fill": "$pheromone.light" }
      ]
    }
  },
  "animations": {
    "read": {
      "description": "held still and reading — the feelers sweep the air while the body barely breathes, which is the whole tell before it commits",
      "duration": 1.8,
      "tracks": [
        { "part": "feeler", "prop": "rot", "keys": [[0, 52], [0.5, 32], [1, 52]] },
        { "part": "feeler_far", "prop": "rot", "keys": [[0, 30], [0.5, 48], [1, 30]] },
        { "part": "elytra", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "case_up", "prop": "y", "keys": [[0, -3], [0.5, -4.4], [1, -3]] },
        { "part": "pronotum", "prop": "y", "keys": [[0, 0], [0.5, -1.2], [1, 0]] },
        { "part": "head", "prop": "y", "keys": [[0, 1], [0.5, -0.4], [1, 1]] },
        { "part": "leg_b", "prop": "rot", "keys": [[0, 32], [0.5, 40], [1, 32]] },
        { "part": "leg_m", "prop": "rot", "keys": [[0, 8], [0.5, -2], [1, 8]] },
        { "part": "leg_f", "prop": "rot", "keys": [[0, -26], [0.5, -34], [1, -26]] },
        { "part": "leg_far_b", "prop": "rot", "keys": [[0, 36], [0.5, 26], [1, 36]] },
        { "part": "organ", "prop": "scale", "keys": [[0, 1], [0.5, 1.14], [1, 1]] },
        { "part": "eye_glow", "prop": "opacity", "keys": [[0, 0.65], [0.5, 1], [1, 0.65]] }
      ]
    }
  }
}
