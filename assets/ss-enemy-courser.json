{
  "id": "ss.enemy.courser",
  "name": "Courser",
  "description": "The caste that answers a Chorus. Everything else in the hive walks toward you; this one holds still, reads the air, and then commits the whole body along the line it read — so it is built as an arrow: a nested dart marching forward to a bone point, and a fan of fletching off the flat tail that sweeps while it reads. That sweep is the tell before it moves. Nested the way the Chorus is ringed, which is the same emblem construction turned directional, and angular against the Matriarch's round mass so the three are still three creatures as flat silhouettes. Crimson because nothing else in the hive is: the Chorus is amber and the Matriarch is violet, and a body that crosses the field in half a second has to be told apart in the half second it is doing it. Drawn facing +x, the game flips it. Gameplay radius 44.",
  "tags": ["ss-enemy", "boss"],
  "size": [112, 96],
  "meta": { "radius": 44 },
  "parts": [
    { "id": "fletch_a", "at": [-24, -15], "rot": -58, "shape": { "kind": "poly", "points": [[-8, 8], [0, -18], [8, 8]] }, "fill": "$husk.dark" },
    { "id": "fletch_b", "at": [-25, -5], "rot": -78, "shape": { "kind": "poly", "points": [[-8, 8], [0, -22], [8, 8]] }, "fill": "$husk.dark" },
