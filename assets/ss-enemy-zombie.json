{
  "id": "ss.enemy.zombie",
  "name": "Husk",
  "description": "A drone that ran out of scent and stopped being anybody — the hive grafted an organ onto its chest and it walks again. Bleached bone, slumped forward, one arm hanging longer than the other. Tall and pale where the Tracker is low and amber: at a glance you are reading height and value, not detail.",
  "tags": ["ss-enemy", "shambler"],
  "size": [32, 36],
  "meta": { "radius": 11 },
  "parts": [
    { "id": "arm_far", "at": [-6.4, -1.4], "rot": -12, "shape": { "kind": "rect", "w": 4.4, "h": 15, "corner": 2.2 }, "fill": "$husk.dark2" },
    { "id": "leg_far", "at": [-2.6, 9.4], "rot": 8, "shape": { "kind": "rect", "w": 5, "h": 12, "corner": 2.4 }, "fill": "$husk.dark2" },
    { "id": "leg", "at": [3.4, 10], "rot": -6, "shape": { "kind": "rect", "w": 5.4, "h": 12.4, "corner": 2.6 }, "fill": "$husk.dark" },
    { "id": "torso", "at": [0, -1], "rot": 7, "shape": { "kind": "poly", "points": [[6.6, -8], [-5.6, -8.6], [-8, -0.4], [-6, 7.4], [5.4, 7.8], [8, -0.6]] }, "fill": "$husk", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "crack", "at": [-1.4, -1.4], "rot": 76, "shape": { "kind": "poly", "points": [[-6, 0], [-2, -1.2], [1.6, 0.8], [5.4, -0.6], [5.4, 0.7], [1.5, 1.7], [-2.1, 0.1]] }, "fill": "$husk.dark2" },
    { "id": "head", "at": [2, -12.4], "rot": 12, "shape": { "kind": "poly", "points": [[4.6, -2], [1.8, -5], [-3.4, -4], [-4.8, 0.8], [-1.8, 4], [3.6, 3.2]] }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "socket", "at": [3.4, -12], "shape": { "kind": "ellipse", "rx": 2.2, "ry": 2.8 }, "fill": "$ink" },
    { "id": "arm", "at": [7, -2.4], "rot": -20, "shape": { "kind": "rect", "w": 4.8, "h": 17, "corner": 2.4 }, "fill": "$husk.dark", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "graft", "at": [1.2, -1.8], "shape": { "kind": "ngon", "sides": 6, "r": 5, "rot": 12 }, "fill": "$carapace.dark" },
    { "id": "organ", "use": "ss.lib.organ", "variant": "faint", "at": [1.2, -1.8], "scale": 0.72 }
  ],
  "variants": {
    "elite": {
      "description": "The hive doubled down: a fresh fully lit graft in the shoulder beside the dying one in the chest.",
      "scale": 1.25,
      "add": [
        { "id": "graft2", "at": [-4.6, -6.4], "shape": { "kind": "ngon", "sides": 6, "r": 3.2, "rot": 20 }, "fill": "$carapace.dark" },
        { "id": "organ2", "use": "ss.lib.organ", "at": [-4.6, -6.4], "scale": 0.46 }
      ]
    }
  },
  "animations": {
    "shamble": {
      "description": "heavy lopsided gait — the long arm swings a beat behind the legs",
      "duration": 1.1,
      "tracks": [
        { "part": "torso", "prop": "rot", "keys": [[0, 0], [0.5, 4], [1, 0]] },
        { "part": "head", "prop": "rot", "keys": [[0, 0], [0.5, -6], [1, 0]] },
        { "part": "leg", "prop": "rot", "keys": [[0, 0], [0.5, 16], [1, 0]] },
        { "part": "leg_far", "prop": "rot", "keys": [[0, 0], [0.5, -16], [1, 0]] },
        { "part": "arm", "prop": "rot", "keys": [[0, 0], [0.5, -16], [1, 0]] },
        { "part": "arm_far", "prop": "rot", "keys": [[0, 0], [0.5, 16], [1, 0]] }
      ]
    }
  }
}
