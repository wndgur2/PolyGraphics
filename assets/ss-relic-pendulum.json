    {"id": "ridge_a", "at": [0, -3.7], "shape": {"kind": "ring", "r": 7.1, "width": 1.5, "from": 200, "to": 340}, "fill": "$carapace.dark2"},
    {"id": "ridge_b", "at": [0, 0.8], "shape": {"kind": "ring", "r": 7.9, "width": 1.4, "from": 195, "to": 345}, "fill": "$carapace.dark2"},
