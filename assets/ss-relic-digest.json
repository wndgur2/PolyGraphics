    {"id": "antenna", "at": [-12.2, -6.2], "rot": -38, "shape": {"kind": "rect", "w": 1.1, "h": 5.2, "corner": 0.6}, "fill": "$chitin.dark"},
    {"id": "head", "at": [-9.6, -1.6], "shape": {"kind": "circle", "r": 3.2}, "fill": "$chitin.dark"},
    {"id": "body", "at": [1.2, 1.4], "rot": -8, "shape": {"kind": "ellipse", "rx": 10.2, "ry": 7.4}, "fill": "$chitin"},
