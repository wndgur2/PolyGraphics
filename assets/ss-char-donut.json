{
  "id": "ss.char.donut",
  "name": "Donut",
  "description": "Sealed survivor built around a hole — the shell closed into a ring where the emitter chamber used to be, so this one didn't just go quiet, it grew over the wound. The dead organ sits on the rim, off to one side.",
  "tags": ["ss-char"],
  "size": [32, 32],
  "meta": { "radius": 11.5 },
  "parts": [
    { "id": "antenna_far", "use": "ss.lib.antenna", "variant": "dead", "at": [1.6, -10.2], "rot": -38, "scale": 0.52 },
    { "id": "shell", "shape": { "kind": "circle", "r": 11.5 }, "fill": "$coral", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "core", "at": [-0.6, -0.6], "shape": { "kind": "circle", "r": 9 }, "fill": "$coral.light2" },
    { "id": "hole_rim", "shape": { "kind": "circle", "r": 4.6 }, "fill": "$coral.dark2" },
    { "id": "hole", "shape": { "kind": "circle", "r": 3.4 }, "fill": "$coral.dark2" },
    { "id": "gloss", "at": [-5.4, -5.6], "rot": -34, "shape": { "kind": "ellipse", "rx": 2.6, "ry": 1.3 }, "fill": "$silent@soft" },
    { "id": "antenna", "use": "ss.lib.antenna", "variant": "dead", "at": [5.4, -8], "rot": -6, "scale": 0.72 },
    { "id": "organ", "use": "ss.lib.organ", "variant": "dead", "at": [7.2, 2.4], "scale": 0.5 }
  ],
  "animations": {
    "idle": {
      "description": "the shell holds its breath; the dead feelers keep sweeping for a signal that never comes",
      "duration": 1.15,
      "tracks": [
        { "part": "shell", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "core", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "hole_rim", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "hole", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "gloss", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "organ", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "antenna", "prop": "rot", "keys": [[0, -13], [0.35, 17], [0.7, -4], [1, -13]] },
        { "part": "antenna_far", "prop": "rot", "keys": [[0, 14], [0.4, -12], [0.75, 6], [1, 14]] }
      ]
    },
    "whip": {
      "description": "the near feeler shoots out past the shell — four times its length, well outside the body — and snaps back, twice; the far one counter-sweeps behind it. In this brood the whip is the animal, not a tool it holds, so the throw has to be visible in the feeler itself — one animated prop per part means the near one spends its channel on reach and the far one on the arc.",
      "duration": 0.35,
      "tracks": [
        { "part": "antenna", "prop": "scale", "keys": [[0, 1], [0.08, 4.4], [0.24, 1.4], [0.38, 3.6], [0.62, 1.1], [1, 1]] },
        { "part": "antenna_far", "prop": "rot", "keys": [[0, 14], [0.1, -46], [0.24, 26], [0.38, -38], [0.6, 18], [1, 14]] }
      ]
    }
