{
  "id": "ss.env.menu",
  "name": "Home screen — the hive at night",
  "description": "The premise as one picture: a whole horizon that glows and signals, and one cold sealed thing down at the left that does not. Pheromone spires rise in three depth bands, a Chorus burns low on the right, and scent drifts up off the ground everywhere except around the survivor. Composed for the menu it sits behind — the middle is deliberately the darkest, quietest part of the frame so the title, cast row and buttons stay readable over it, with all the incident pushed to the edges and the floor.",
  "tags": ["ss-env", "menu"],
  "size": [640, 360],
  "parts": [
    { "id": "sky", "shape": { "kind": "rect", "w": 640, "h": 360 }, "fill": { "gradient": "linear", "from": [0.5, 0], "to": [0.5, 1], "stops": [[0, "$ink"], [0.55, "$soil"], [1, "$rust.dark2"]] } },

    { "id": "chorus_glow", "at": [214, 46], "shape": { "kind": "circle", "r": 150 }, "fill": "$pheromone@0.06" },
    { "id": "chorus_glow2", "at": [214, 46], "shape": { "kind": "circle", "r": 82 }, "fill": "$pheromone@0.07" },

    { "id": "far_a", "at": [-232, 22], "shape": { "kind": "poly", "points": [[0, -138], [26, 96], [-26, 96]] }, "fill": "$soil.light" },
    { "id": "far_b", "at": [-150, 40], "shape": { "kind": "poly", "points": [[0, -96], [20, 78], [-20, 78]] }, "fill": "$soil.light" },
    { "id": "far_c", "at": [96, 30], "shape": { "kind": "poly", "points": [[0, -120], [24, 88], [-24, 88]] }, "fill": "$soil.light" },
    { "id": "far_d", "at": [268, 44], "shape": { "kind": "poly", "points": [[0, -84], [18, 74], [-18, 74]] }, "fill": "$soil.light" },

    { "id": "mid_a", "at": [-262, 74], "shape": { "kind": "poly", "points": [[0, -116], [30, 74], [-30, 74]] }, "fill": "$carapace.dark", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "mid_a_tip", "at": [-262, -18], "shape": { "kind": "poly", "points": [[0, -24], [9, 22], [-9, 22]] }, "fill": "$pheromone.dark" },
    { "id": "mid_b", "at": [186, 66], "shape": { "kind": "poly", "points": [[0, -142], [34, 82], [-34, 82]] }, "fill": "$carapace.dark", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "mid_b_tip", "at": [186, -50], "shape": { "kind": "poly", "points": [[0, -28], [10, 26], [-10, 26]] }, "fill": "$pheromone.dark" },
    { "id": "mid_c", "at": [248, 84], "shape": { "kind": "poly", "points": [[0, -88], [24, 56], [-24, 56]] }, "fill": "$carapace.dark", "stroke": { "color": "$ink", "width": "thin" } },

    { "id": "chorus", "at": [214, 46], "shape": { "kind": "ngon", "sides": 12, "r": 30 }, "fill": "$chitin.dark2", "stroke": { "color": "$ink", "width": "bold" } },
    { "id": "chorus_ring", "at": [214, 46], "shape": { "kind": "ring", "r": 21, "width": 5 }, "fill": "$husk.dark" },
    { "id": "chorus_vent", "at": [214, 46], "shape": { "kind": "circle", "r": 9 }, "fill": { "gradient": "radial", "from": [0.5, 0.5], "stops": [[0, "$pheromone.light"], [1, "$pheromone@0.15"]] } },
    { "id": "chorus_organ_a", "use": "ss.lib.organ", "at": [244, 46], "scale": 0.62 },
    { "id": "chorus_organ_b", "use": "ss.lib.organ", "at": [199, 72], "scale": 0.62 },
    { "id": "chorus_organ_c", "use": "ss.lib.organ", "at": [199, 20], "scale": 0.62 },

    { "id": "horizon", "at": [0, 152], "shape": { "kind": "rect", "w": 660, "h": 60 }, "fill": "$rust.dark2" },
    { "id": "ground", "at": [0, 214], "shape": { "kind": "rect", "w": 660, "h": 100 }, "fill": "$soil" },
    { "id": "ground_lip", "at": [0, 164], "shape": { "kind": "ellipse", "rx": 340, "ry": 16 }, "fill": "$rust.dark" },

    { "id": "dust", "repeat": { "of": { "kind": "circle", "r": 2.2 }, "count": 34, "area": [620, 150], "seed": 91, "scaleRange": [0.4, 1.5] }, "at": [0, 96], "fill": "$pheromone@0.13" },
    { "id": "grit", "repeat": { "of": { "kind": "rect", "w": 3, "h": 3 }, "count": 26, "area": [620, 96], "seed": 92, "jitterRot": true, "scaleRange": [0.5, 1.4] }, "at": [0, 196], "fill": "$rust@soft" },

    { "id": "wisp_l", "use": "ss.lib.wisp", "at": [-186, 176], "scale": 2.1 },
    { "id": "wisp_r", "use": "ss.lib.wisp", "at": [128, 168], "scale": 1.7 },
    { "id": "wisp_far", "use": "ss.lib.wisp", "at": [286, 160], "scale": 1.3 },

    { "id": "survivor_shadow", "at": [-236, 178], "shape": { "kind": "ellipse", "rx": 30, "ry": 7 }, "fill": "$ink@heavy" },
    { "id": "survivor", "use": "ss.char.dot", "at": [-236, 154], "scale": 1.9 }
  ],
  "animations": {
    "drift": {
      "description": "the hive breathes and the dust rises; the survivor holds still",
      "duration": 4.5,
      "tracks": [
        { "part": "chorus_glow", "prop": "scale", "keys": [[0, 1], [0.5, 1.09], [1, 1]] },
        { "part": "chorus_glow2", "prop": "opacity", "keys": [[0, 1], [0.5, 1.5], [1, 1]] },
        { "part": "dust", "prop": "y", "keys": [[0, 0], [1, -22]], "ease": "linear" },
        { "part": "mid_a_tip", "prop": "opacity", "keys": [[0, 0.8], [0.5, 1], [1, 0.8]] },
        { "part": "mid_b_tip", "prop": "opacity", "keys": [[0, 1], [0.5, 0.75], [1, 1]] }
      ]
    }
  }
}
