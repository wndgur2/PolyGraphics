{
  "id": "icon.boomerang",
  "name": "Boomerang icon",
  "description": "UI slot icon: rounded tile + frost rim + the actual weapon.boomerang document composed via `use` — no second hand-drawn copy. Evolved variant swaps the rim to gold and adds a spark.",
  "tags": ["icon", "ui"],
  "size": [32, 32],
  "parts": [
    { "id": "tile", "shape": { "kind": "rect", "w": 30, "h": 30, "corner": 7 }, "fill": "$slate.dark2" },
    { "id": "inner", "shape": { "kind": "rect", "w": 25, "h": 25, "corner": 5 }, "fill": "$slate.dark" },
    { "id": "rim", "shape": { "kind": "rect", "w": 29, "h": 29, "corner": 7 }, "stroke": { "color": "$frost", "width": "thin" } },
    { "id": "glyph", "use": "weapon.boomerang", "scale": 0.85 }
  ],
  "variants": {
    "evolved": {
      "description": "Gold rim + corner spark; the `_evo` twin, derived instead of re-drawn.",
      "set": { "rim.stroke.color": "$gold" },
      "add": [
        { "id": "spark", "at": [10.5, -10.5], "shape": { "kind": "star", "points": 4, "r": 3.6, "r2": 1.3 }, "fill": "$gold" }
      ]
    }
  }
}
