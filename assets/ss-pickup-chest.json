{
  "id": "ss.pickup.chest",
  "name": "Brood chest",
  "description": "A hive strongbox: a chitin case with a lid that overhangs the body, two bone straps around it and a gold latch. It reads as a chest first — lid line, straps, latch, in that order — because that is the whole job of the shape, and the reward screen blows it up to 1.9× where a vague silhouette would show. Still hive-built rather than pirate: the case is chitin, the straps are bone, and something inside is faintly lit.",
  "tags": ["ss-pickup"],
  "size": [28, 24],
  "parts": [
    { "id": "glow", "at": [0, -1], "shape": { "kind": "circle", "r": 11.5 }, "fill": "$gold@ghost" },
    { "id": "body", "at": [0, 4.6], "shape": { "kind": "rect", "w": 21, "h": 12, "corner": 2 }, "fill": "$chitin", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "body_shade", "at": [0, 9], "shape": { "kind": "rect", "w": 19, "h": 3, "corner": 1.4 }, "fill": "$chitin.dark" },
    { "id": "lid", "at": [0, -3.4], "shape": { "kind": "rect", "w": 24, "h": 9, "corner": 2.6 }, "fill": "$chitin.light", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "lid_shine", "at": [0, -5.8], "shape": { "kind": "rect", "w": 17, "h": 2.4, "corner": 1.2 }, "fill": "$husk" },
    { "id": "seam", "at": [0, 1.4], "shape": { "kind": "rect", "w": 23.4, "h": 1.5 }, "fill": "$ink" },
    { "id": "strap", "mirrorX": true, "at": [-6.8, 1.3], "shape": { "kind": "rect", "w": 2.8, "h": 17.2, "corner": 0.8 }, "fill": "$husk.dark" },
    { "id": "latch", "at": [0, 1.6], "shape": { "kind": "rect", "w": 6.2, "h": 5.4, "corner": 1.2 }, "fill": "$gold", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "keyhole", "at": [0, 1.8], "shape": { "kind": "circle", "r": 1.2 }, "fill": "$ink" }
  ],
  "variants": {
    "cursed": {
      "description": "This one was not forgotten. The case is dark, the latch has gone the colour of the hive, and something behind the seam is looking back.",
      "set": {
        "body.fill": "$carapace.light",
        "body_shade.fill": "$carapace",
        "lid.fill": "$carapace.light2",
        "lid_shine.fill": "$carapace.light",
        "strap.fill": "$carapace.dark",
        "latch.fill": "$pheromone",
        "glow.fill": "$pheromone@ghost"
      },
      "add": [
        { "id": "eye", "mirrorX": true, "at": [-4.6, 1.4], "shape": { "kind": "circle", "r": 1.1 }, "fill": "$pheromone.light" }
      ]
    }
  },
  "animations": {
    "tease": {
      "description": "the lid knocks against the latch — something inside wants out",
      "duration": 1.5,
      "tracks": [
        { "part": "lid", "prop": "y", "keys": [[0, 0], [0.42, 0], [0.52, -1.8], [0.66, 0.4], [0.76, 0], [1, 0]] },
        { "part": "lid_shine", "prop": "y", "keys": [[0, 0], [0.42, 0], [0.52, -1.8], [0.66, 0.4], [0.76, 0], [1, 0]] },
        { "part": "latch", "prop": "rot", "keys": [[0, 0], [0.42, 0], [0.54, -7], [0.68, 4], [0.8, 0], [1, 0]] },
        { "part": "glow", "prop": "scale", "keys": [[0, 1], [0.5, 1.16], [1, 1]] }
      ]
    }
  }
}
