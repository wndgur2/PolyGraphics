    { "id": "gloss", "at": [-4.4, -5.4], "shape": { "kind": "rect", "w": 6.4, "h": 2, "corner": 1 }, "fill": "$silent@soft" },
    { "id": "seam", "at": [0, 4.6], "shape": { "kind": "rect", "w": 22, "h": 1.1 }, "fill": "$gold.dark2" },
    { "id": "rivet_a", "at": [-7.4, 4.6], "shape": { "kind": "circle", "r": 1.1 }, "fill": "$gold.dark2" },
    { "id": "rivet_b", "at": [7.4, 4.6], "shape": { "kind": "circle", "r": 1.1 }, "fill": "$gold.dark2" },
    { "id": "gills", "at": [0, -8.4], "shape": { "kind": "ellipse", "rx": 13.2, "ry": 2.2 }, "fill": "$gold.dark2" },
