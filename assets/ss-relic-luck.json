    {"id": "leaf_tl_outline", "at": [-4.2, -4.4], "shape": {"kind": "circle", "r": 6.4}, "fill": "$ink"},
    {"id": "leaf_tr_outline", "at": [4.2, -4.4], "shape": {"kind": "circle", "r": 6.4}, "fill": "$ink"},
