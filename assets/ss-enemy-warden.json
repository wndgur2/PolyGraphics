    {"id": "plug", "at": [33, -2], "shape": {"kind": "ellipse", "rx": 12.4, "ry": 18.4}, "fill": "$rust"},
    {"id": "strata_a", "at": [26.5, -2], "shape": {"kind": "rect", "w": 2.4, "h": 27}, "fill": "$rust.dark2"},
