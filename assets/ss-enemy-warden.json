{
  "id": "ss.enemy.warden",
  "name": "Warden",
  "description": "A soldier bred as a door. The head is a flat plug of packed earth that spent this creature's whole life filling one passage, and it has left that passage to come and find you — so the silhouette is a mass with a shield at one end, asymmetric where the Chorus is a disc symmetric about everything. It is the same colour as the ground it dug, which is a problem the art has to solve rather than avoid: the plug carries a bone rim all the way round, the strata across its face are cut hard, and three organs burn out from behind it. Under the shield is the acid vent — teal, because what comes out of it is `ss.enemy.shot`. In the `enraged` half that vent goes dark and the plug splits: it has stopped holding the passage and started closing it. Drawn facing +x, the game flips it. Gameplay radius 42.",
  "tags": ["ss-enemy", "boss"],
  "size": [104, 96],
  "meta": {"radius": 42},
  "parts": [
    {"id": "leg_b", "at": [-26, 29], "rot": 24, "shape": {"kind": "rect", "w": 10, "h": 24, "corner": 5}, "fill": "$carapace.dark"},
    {"id": "leg_m", "at": [-6, 32], "rot": 6, "shape": {"kind": "rect", "w": 10, "h": 24, "corner": 5}, "fill": "$carapace.dark"},
    {"id": "leg_f", "at": [12, 28], "rot": -16, "shape": {"kind": "rect", "w": 9, "h": 22, "corner": 4.5}, "fill": "$carapace.dark"},
    {"id": "spines", "at": [-18, 0], "shape": {"kind": "star", "points": 10, "r": 30, "r2": 26}, "fill": "$husk.dark2"},
    {"id": "abdomen", "at": [-18, 0], "shape": {"kind": "ellipse", "rx": 26, "ry": 24}, "fill": "$chitin.dark", "stroke": {"color": "$ink", "width": "heavy"}},
    {"id": "backplate", "at": [-18, 0], "shape": {"kind": "ring", "r": 18, "width": 6}, "fill": "$husk.dark"},
    {"id": "thorax", "at": [9, 2], "shape": {"kind": "ellipse", "rx": 15, "ry": 16}, "fill": "$chitin.dark2", "stroke": {"color": "$ink", "width": "bold"}},
