    {"id": "strata_d", "at": [41, -2], "shape": {"kind": "rect", "w": 2.2, "h": 22}, "fill": "$rust.dark2"},
    {"id": "notch", "at": [33, -20.5], "shape": {"kind": "poly", "points": [[-6, 2.4], [-2.4, -3.2], [1.6, 2], [5.4, -2.6], [7, 2.8]]}, "fill": "$husk.dark2"},
    {"id": "organ_a", "at": [15, -20], "use": "ss.lib.organ", "scale": 0.9},
    {"id": "organ_b", "at": [-8, -23], "use": "ss.lib.organ", "scale": 0.72},
    {"id": "organ_c", "at": [-33, 7], "use": "ss.lib.organ", "scale": 0.62}
