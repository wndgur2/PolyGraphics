{
  "id": "ss.proj.mine",
  "name": "Lure cap",
  "description": "A hollowed case grown a fruiting body and set down to wait, calling while it does. The pod it replaces hid: its fuse was deliberately cold, on the reasoning that a magenta glow means something is calling the hive and you do not want your own trap advertising you. This is the opposite argument and the better one — a mine nothing walks near does nothing — so the cap wears the hive's colour and the scent goes out in rings. It is the one thing in the arsenal allowed to be pink, because it is the one thing whose job is to be walked towards; it is bait in the player's hand rather than the player's voice, which is also why it is set down rather than carried. The rest of it is kept deliberately unmushroomlike, because a lure that does not also read as a trap is just scenery: bone trip-hairs on the rim where a cap would have nothing, a machined band with rivets holding the dome in, and a seated white light that ticks while it is armed.",
  "tags": ["ss-proj", "trap"],
  "size": [24, 28],
  "parts": [
    { "id": "bloom", "at": [0, 1.8], "shape": { "kind": "ellipse", "rx": 11, "ry": 7.6 }, "fill": "$pink@ghost" },
    { "id": "call_out", "at": [0, 1.8], "scale": [1, 0.7], "shape": { "kind": "ring", "r": 10.2, "width": 1 }, "fill": "$pink@0.24" },
    { "id": "call_in", "at": [0, 1.8], "scale": [1, 0.7], "shape": { "kind": "ring", "r": 7.6, "width": 1.3 }, "fill": "$pink@0.38" },
    { "id": "prong_side", "at": [8.4, 2.4], "rot": -6, "mirrorX": true, "shape": { "kind": "poly", "points": [[0, -1.3], [5.4, -0.3], [5.4, 0.3], [0, 1.3]] }, "fill": "$husk.dark" },
    { "id": "prong_tip", "at": [13.1, 1.9], "rot": -6, "mirrorX": true, "shape": { "kind": "circle", "r": 0.6 }, "fill": "$husk" },
