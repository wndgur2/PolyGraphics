{
  "id": "ss.enemy.imp",
  "name": "Tracker",
  "description": "The hive's first responder — the one that found you. One bright chitin body, a dark maw at the front, two thick feelers and a lit organ on its back. Deliberately not an insect: at four hundred on screen you read a shape and a glow, not anatomy, so head and thorax are fused and the legs are three stubs. Gameplay slot unchanged (fast, weak melee chaser); body radius still 8.5.",
  "tags": ["ss-enemy", "tracker"],
  "size": [32, 32],
  "meta": { "radius": 8.5 },
  "parts": [
    { "id": "leg_b", "at": [-6, 6.4], "rot": 18, "shape": { "kind": "rect", "w": 3.4, "h": 7.6, "corner": 1.6 }, "fill": "$carapace.dark" },
    { "id": "leg_m", "at": [0.4, 7.4], "shape": { "kind": "rect", "w": 3.4, "h": 7.6, "corner": 1.6 }, "fill": "$carapace.dark" },
    { "id": "leg_f", "at": [6.4, 6.2], "rot": -16, "shape": { "kind": "rect", "w": 3.4, "h": 7.6, "corner": 1.6 }, "fill": "$carapace.dark" },
    { "id": "feeler_far", "at": [3.4, -6.6], "rot": -34, "shape": { "kind": "rect", "w": 2.4, "h": 11, "corner": 1.2 }, "fill": "$carapace" },
    { "id": "feeler", "at": [7, -6.2], "rot": 22, "shape": { "kind": "rect", "w": 2.6, "h": 12, "corner": 1.3 }, "fill": "$carapace.light" },
    { "id": "body", "at": [-0.4, 0.4], "shape": { "kind": "ellipse", "rx": 10.4, "ry": 8.4 }, "fill": "$chitin", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "back", "at": [-2.4, -2.4], "shape": { "kind": "ellipse", "rx": 6.6, "ry": 4.2 }, "fill": "$chitin.light" },
    { "id": "maw", "at": [8.2, 2.4], "shape": { "kind": "poly", "points": [[2.4, -3.4], [-2.6, -1.6], [-2.6, 2], [2.6, 3.4], [1.2, 0]] }, "fill": "$ink" },
    { "id": "fang", "at": [8.6, 2.4], "shape": { "kind": "poly", "points": [[2.8, -2.4], [-1, -0.6], [2.8, 0.4]] }, "fill": "$husk" },
    { "id": "organ", "use": "ss.lib.organ", "at": [-3.2, -4], "scale": [0.62, 0.5] }
  ],
  "variants": {
    "elite": {
      "description": "Marked by the hive: bleached shell, a heavier maw and a brighter organ.",
      "scale": 1.25,
      "set": { "body.fill": "$husk.dark", "back.fill": "$husk", "organ.scale": [0.78, 0.62], "fang.scale": [1.3, 1.3] }
    }
  },
  "animations": {
    "scuttle": {
      "description": "legs cycle out of phase, body bobs, feelers sweep",
      "duration": 0.5,
      "tracks": [
        { "part": "leg_b", "prop": "rot", "keys": [[0, 18], [0.5, 34], [1, 18]] },
        { "part": "leg_m", "prop": "rot", "keys": [[0, 8], [0.5, -8], [1, 8]] },
        { "part": "leg_f", "prop": "rot", "keys": [[0, -30], [0.5, -12], [1, -30]] },
        { "part": "body", "prop": "y", "keys": [[0, 0.8], [0.5, -0.4], [1, 0.8]] },
        { "part": "back", "prop": "y", "keys": [[0, -2], [0.5, -3.2], [1, -2]] },
        { "part": "feeler", "prop": "rot", "keys": [[0, 16], [0.5, 30], [1, 16]] },
        { "part": "feeler_far", "prop": "rot", "keys": [[0, -30], [0.5, -40], [1, -30]] }
      ]
    }
  }
}
