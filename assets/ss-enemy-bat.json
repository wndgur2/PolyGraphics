    { "id": "thorax", "at": [1.8, 0.6], "shape": { "kind": "ellipse", "rx": 4.6, "ry": 3.8 }, "fill": "$chitin.dark", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "th_shine", "at": [1.4, -1], "shape": { "kind": "ellipse", "rx": 2.8, "ry": 1.5 }, "fill": "$chitin" },
    { "id": "head", "at": [7.2, 1.4], "shape": { "kind": "ellipse", "rx": 2.7, "ry": 2.5 }, "fill": "$carapace.light" },
    { "id": "proboscis", "at": [9.6, 1.8], "shape": { "kind": "poly", "points": [[0, -1.1], [6.2, 0.2], [0, 1.3]] }, "fill": "$husk" },
