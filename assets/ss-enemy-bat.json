{
  "id": "ss.enemy.bat",
  "name": "Drifter",
  "description": "Released from a vent to sweep for you. Two pale wings held back over a small dark body, with an organ underneath leaking the trail that tells the ground castes where you were. The wings carry the whole read — a wide bright horizontal against the Tracker's compact blob.",
  "tags": ["ss-enemy", "flier"],
  "size": [36, 28],
  "meta": { "radius": 7 },
  "parts": [
    { "id": "wisp", "use": "ss.lib.wisp", "at": [-13, 3.6], "rot": -104, "scale": 0.58 },
    { "id": "wing_far", "at": [-3.6, 1.4], "rot": 12, "shape": { "kind": "ellipse", "rx": 10.4, "ry": 3 }, "fill": "$steel" },
    { "id": "wing", "at": [-3.4, -3.4], "rot": -16, "shape": { "kind": "ellipse", "rx": 11.6, "ry": 3.6 }, "fill": "$husk", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "vein", "at": [-3.4, -3.4], "rot": -16, "shape": { "kind": "rect", "w": 19, "h": 0.9 }, "fill": "$steel.dark" },
    { "id": "body", "at": [1.6, 1.4], "shape": { "kind": "ellipse", "rx": 7.4, "ry": 4.6 }, "fill": "$chitin.dark", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "shine", "at": [1.2, 0], "shape": { "kind": "ellipse", "rx": 4.6, "ry": 2 }, "fill": "$chitin" },
    { "id": "sting", "at": [-9.4, 2.4], "shape": { "kind": "poly", "points": [[2.6, -2], [-3.6, 0.2], [2.6, 2]] }, "fill": "$husk" },
    { "id": "snout", "at": [9.4, 2], "shape": { "kind": "poly", "points": [[0, -2], [5.6, 0.2], [0, 2.4]] }, "fill": "$husk.dark" },
    { "id": "organ", "use": "ss.lib.organ", "at": [1.4, 4.6], "scale": [0.5, 0.4] }
  ],
  "variants": {
    "elite": {
      "description": "A marked scout: brighter membranes, a heavier sting and a fatter trail.",
      "scale": 1.25,
      "set": { "wing.fill": "$bone.light", "wing_far.fill": "$husk.dark", "sting.scale": [1.4, 1.3], "organ.scale": [0.62, 0.5] }
    }
  },
  "animations": {
    "flit": {
      "description": "wings beat out of phase, body rocks under them",
      "duration": 0.26,
      "tracks": [
        { "part": "wing", "prop": "rot", "keys": [[0, -30], [0.5, -2], [1, -30]] },
        { "part": "vein", "prop": "rot", "keys": [[0, -30], [0.5, -2], [1, -30]] },
        { "part": "wing_far", "prop": "rot", "keys": [[0, 26], [0.5, -2], [1, 26]] },
        { "part": "body", "prop": "y", "keys": [[0, 1], [0.5, 1.9], [1, 1]] },
        { "part": "wisp", "prop": "opacity", "keys": [[0, 0.85], [0.5, 0.5], [1, 0.85]] }
      ]
    }
  }
}
