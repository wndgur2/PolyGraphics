{
  "id": "ss.enemy.bat",
  "name": "Drifter",
  "description": "Released from a vent to sweep for you. Two pairs of long veined wings held back over a segmented body, a barbed abdomen, and an organ underneath that leaks scent as it goes — that trail is how the ground castes learn where you were. Gameplay slot unchanged (fast, fragile swooper); the wide swept-wing silhouette is unmistakable against the Tracker's low crawl.",
  "tags": ["ss-enemy", "flier"],
  "size": [36, 28],
  "meta": { "radius": 7 },
  "parts": [
    { "id": "wisp", "use": "ss.lib.wisp", "at": [-13, 3.6], "rot": -104, "scale": 0.58 },
    { "id": "wing_far_up", "at": [-4.6, -2.6], "rot": -14, "shape": { "kind": "ellipse", "rx": 8.6, "ry": 2.1 }, "fill": "$carapace.light" },
    { "id": "wing_far_dn", "at": [-4.2, 1], "rot": 6, "shape": { "kind": "ellipse", "rx": 7.4, "ry": 1.7 }, "fill": "$carapace" },
