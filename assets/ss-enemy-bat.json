    { "id": "vein_up", "at": [-4, -4.4], "rot": -20, "shape": { "kind": "rect", "w": 15.6, "h": 0.7 }, "fill": "$slate.light" },
    { "id": "wing_dn", "at": [-3.6, -0.4], "rot": -2, "shape": { "kind": "ellipse", "rx": 8, "ry": 2 }, "fill": "$steel", "stroke": { "color": "$ink", "width": "hair" } },
    { "id": "vein_dn", "at": [-3.6, -0.4], "rot": -2, "shape": { "kind": "rect", "w": 13, "h": 0.6 }, "fill": "$slate" },
