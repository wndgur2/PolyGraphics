{
  "id": "ss.char.hex",
  "name": "Hex",
  "description": "Sealed survivor in cell-shaped plating — the same hexagon the hive builds with, worn by something the hive no longer counts. Dead organ, dead feelers, six flat sides that fit nowhere any more.",
  "tags": ["ss-char"],
  "size": [32, 32],
  "meta": { "radius": 11.5 },
  "parts": [
    { "id": "antenna_far", "use": "ss.lib.antenna", "variant": "dead", "at": [2, -9], "rot": -38, "scale": 0.52 },
    { "id": "shell", "shape": { "kind": "ngon", "sides": 6, "r": 11.5, "rot": 30 }, "fill": "$orchid", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "core", "at": [-0.6, -0.6], "shape": { "kind": "ngon", "sides": 6, "r": 8.8, "rot": 30 }, "fill": "$orchid.light2" },
    { "id": "cell", "at": [-0.6, -0.6], "shape": { "kind": "ngon", "sides": 6, "r": 4.6, "rot": 30 }, "fill": "$orchid.light" },
    { "id": "gloss", "at": [-4.6, -5.2], "shape": { "kind": "rect", "w": 5, "h": 1.6, "corner": 0.8 }, "fill": "$silent@soft" },
    { "id": "antenna", "use": "ss.lib.antenna", "variant": "dead", "at": [5.2, -8.6], "rot": -6, "scale": 0.72 },
    { "id": "organ", "use": "ss.lib.organ", "variant": "dead", "at": [5.2, 3.6], "scale": 0.54 }
  ],
  "animations": {
    "idle": {
      "description": "the shell holds its breath; the dead feelers keep sweeping for a signal that never comes",
      "duration": 1.15,
      "tracks": [
        { "part": "shell", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "core", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "cell", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "gloss", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "organ", "prop": "y", "keys": [[0, 0], [0.5, -1.4], [1, 0]] },
        { "part": "antenna", "prop": "rot", "keys": [[0, -13], [0.35, 17], [0.7, -4], [1, -13]] },
        { "part": "antenna_far", "prop": "rot", "keys": [[0, 14], [0.4, -12], [0.75, 6], [1, 14]] }
      ]
    },
    "whip": {
      "description": "the near feeler shoots out to twice its length and snaps back, twice; the far one counter-sweeps behind it. In this brood the whip is the animal, not a tool it holds, so the throw has to be visible in the feeler itself — one animated prop per part means the near one spends its channel on reach and the far one on the arc.",
      "duration": 0.35,
      "tracks": [
        { "part": "antenna", "prop": "scale", "keys": [[0, 1], [0.08, 2.05], [0.24, 1.15], [0.38, 1.8], [0.62, 1.05], [1, 1]] },
        { "part": "antenna_far", "prop": "rot", "keys": [[0, 14], [0.1, -46], [0.24, 26], [0.38, -38], [0.6, 18], [1, 14]] }
      ]
    }
  }
}
