    { "id": "throat", "shape": { "kind": "rect", "w": 4.4, "h": 2.4, "corner": 1 }, "fill": "$venom.dark2" },
    { "id": "gloss", "at": [-4.4, -7.6], "shape": { "kind": "ellipse", "rx": 2.8, "ry": 1.2 }, "fill": "$silent@soft" },
