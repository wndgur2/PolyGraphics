    { "id": "shell_top", "shape": { "kind": "poly", "points": [[-11.4, -12], [11.4, -12], [1.8, -0.6], [-1.8, -0.6]] }, "fill": "$venom", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "shell_bot", "shape": { "kind": "poly", "points": [[-11.4, 12], [11.4, 12], [1.8, 0.6], [-1.8, 0.6]] }, "fill": "$venom", "stroke": { "color": "$ink", "width": "thin" } },
    { "id": "core_top", "shape": { "kind": "poly", "points": [[-8.4, -9.8], [8.4, -9.8], [1.3, -1.4], [-1.3, -1.4]] }, "fill": "$venom.light2" },
