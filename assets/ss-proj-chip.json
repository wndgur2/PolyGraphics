{
  "id": "ss.proj.chip",
  "name": "Shell chip",
  "description": "A splinter the orbiter sheds when it fires — the same hexagon it is, an eighth the size and still cold. Its whole job is to not be mistaken for the dart you throw, so it keeps the drone's grey and none of the violet.",
  "tags": [
    "ss-proj",
    "orbital"
  ],
  "size": [
    10,
    10
  ],
  "parts": [
    {
      "id": "trail",
      "at": [
        -3.2,
        0
      ],
      "shape": {
        "kind": "ellipse",
        "rx": 3.2,
        "ry": 1.1
      },
      "fill": "$frost@ghost"
    },
    {
      "id": "plate",
      "shape": {
        "kind": "ngon",
        "sides": 6,
        "r": 3.4,
        "rot": 30
      },
      "fill": "$steel.dark",
      "stroke": {
        "color": "$ink",
        "width": "hair"
      }
    },
    {
      "id": "face",
      "shape": {
        "kind": "ngon",
        "sides": 6,
        "r": 2.1,
        "rot": 30
      },
      "fill": "$frost.light"
    }
  ],
  "variants": {
    "evolved": {
      "description": "Sentinel Drone's chip, driven hard enough to go through. Nearly twice the size of the one it grew from and lit rather than grey — a shot that pierces has to be findable on a dark floor, and the unevolved chip is deliberately small enough to lose.",
      "scale": 1.9,
      "set": {
        "trail.fill": "$aqua@soft",
        "plate.fill": "$frost.dark",
        "face.fill": "$white"
      },
      "add": [
        {
          "id": "halo",
          "shape": {
            "kind": "ellipse",
            "rx": 6.4,
            "ry": 3.4
          },
          "fill": "$aqua@ghost"
        },
        {
          "id": "lance",
          "at": [
            2.2,
            0
          ],
          "shape": {
            "kind": "poly",
            "points": [
              [
                5.8,
                0
              ],
              [
                0.6,
                -2
              ],
              [
                -3.6,
                0
              ],
              [
                0.6,
                2
              ]
            ]
          },
          "fill": "$aqua.light",
          "stroke": {
            "color": "$ink",
            "width": "hair"
          }
        },
        {
          "id": "spark",
          "at": [
            5.6,
            0
          ],
          "shape": {
            "kind": "circle",
            "r": 1.5
          },
          "fill": "$white"
        }
      ]
    }
  }
}